---
import type { Lang } from "../i18n/ui";
import { useTranslations, localePath, lx } from "../i18n/utils";
import { formatDate } from "../utils/format";
import { programById } from "../data/programs";
import type { Entry } from "../data/types";
import { objectPosition } from "../utils/format";
import { ArrowUpRight } from "lucide-astro";

interface Props {
  entry: Entry;
  lang: Lang;
  basePath: string;
  showProgram?: boolean;
  showAuthor?: boolean;
}

const { entry, lang, basePath, showProgram = true, showAuthor = false } = Astro.props;
const t = useTranslations(lang);
const program = entry.program ? programById(entry.program) : undefined;
const href = localePath(`${basePath}/${entry.slug}`, lang);

const meta = entry.date
  ? formatDate(entry.date, lang)
  : entry.period
    ? lx(entry.period, lang)
    : null;
---

<div class="card-wrap">
  <article
    class:list={["card", `accent-${program?.accent ?? "brand"}`, { "no-image": !entry.image }]}
  >
    {entry.image && (
      <div class="media">
        <img
          class="thumb"
          src={entry.image}
          alt={entry.imageAlt ? lx(entry.imageAlt, lang) : ""}
          style={`object-position:${objectPosition(entry.imageFocal)}`}
          loading="lazy"
          decoding="async"
        />
      </div>
    )}

    <div class="text">
      <p class="meta">
        <span class="date">{meta ?? t("common.dateUnknown")}</span>
        {showAuthor && entry.author && <span class="author">{entry.author}</span>}
        {showProgram && program && (
          <span class="prog-inline">{lx(program.kicker, lang)}</span>
        )}
      </p>

      <h3 class="title">
        <a href={href}>
          <span>{lx(entry.title, lang)}</span>
          <ArrowUpRight size={20} stroke-width={1.8} aria-hidden="true" />
        </a>
      </h3>

      <p class="summary">{lx(entry.summary, lang)}</p>

      {entry.location && <p class="place">{lx(entry.location, lang)}</p>}
    </div>
  </article>
</div>

<style>
  .card-wrap {
    container-type: inline-size;
    height: 100%;
  }
  .card {
    position: relative;
    display: grid;
    gap: var(--s-4);
    align-content: start;
    height: 100%;
  }
  .media {
    position: relative;
    overflow: hidden;
    border-radius: var(--r-4);
    background: var(--paper-sunk);
  }
  .thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    filter: var(--photo-filter);
    transition: filter var(--dur-3) var(--ease-out);
  }
  .card:hover .thumb {
    filter: saturate(1.05) contrast(1.04);
  }
  .prog-inline {
    display: inline-flex;
    align-items: center;
    gap: 0.45em;
  }
  .text {
    display: grid;
    gap: var(--s-3);
    align-content: start;
  }
  .meta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-4);
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .title {
    margin: 0;
    font-size: var(--step-2);
    line-height: 1.1;
  }
  .title a {
    text-decoration: none;
  }
  /* The whole card is the link target; the title carries the accessible name. */
  .title a::after {
    content: "";
    position: absolute;
    inset: 0;
    border-radius: var(--r-4);
  }
  .title span {
    background-image: linear-gradient(var(--accent-fill), var(--accent-fill));
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 2px;
    transition: background-size var(--dur-3) var(--ease-out);
  }
  .card:hover .title span {
    background-size: 100% 2px;
  }
  .title :global(svg) {
    display: inline-block;
    vertical-align: -0.1em;
    margin-left: 0.2em;
    color: var(--accent);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .card:hover .title :global(svg) {
    transform: translate(3px, -3px);
  }
  .title a:focus-visible {
    outline: none;
  }
  .title a:focus-visible::after {
    outline: 2px solid var(--clay);
    outline-offset: 4px;
  }
  .summary {
    margin: 0;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .place {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .no-image {
    padding-top: var(--s-5);
    border-top: 2px solid var(--accent-fill);
  }

  /* A card given the full width becomes a lead: photograph beside the text. */
  @container (min-width: 46rem) {
    .card:not(.no-image) {
      grid-template-columns: minmax(0, 1.35fr) minmax(0, 1fr);
      gap: clamp(2rem, 4vw, 3.5rem);
      align-items: center;
    }
    .thumb {
      aspect-ratio: 3 / 2;
    }
    .title {
      font-size: var(--step-4);
      line-height: 1.02;
    }
    .summary {
      font-size: var(--step-1);
      line-height: 1.5;
    }
  }
</style>
