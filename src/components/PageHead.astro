---
/**
 * The header every inner page opens with: a large display title, the lede
 * beside it on wide screens, and a label only where it adds information.
 */
interface Props {
  kicker: string;
  title: string;
  lede?: string;
  accent?: string;
}
const { kicker, title, lede, accent = "brand" } = Astro.props;
// A label that only repeats the title ("Donate" above "Donate to Bhoomi Seva")
// is decoration. Show it only when it tells the reader something new.
const showKicker = !title.toLowerCase().includes(kicker.toLowerCase());
---

<header class:list={["page-head", `accent-${accent}`]}>
  <div class="container">
    <slot name="above" />
    <div class="page-head__grid">
      <div>
        {showKicker && <p class="eyebrow">{kicker}</p>}
        <h1>{title}</h1>
      </div>
      {lede && <p class="lede">{lede}</p>}
    </div>
    <slot />
  </div>
</header>
