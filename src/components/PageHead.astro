---
/**
 * The header every inner page opens with: a sentence-case label, a large
 * display title, and the lede set beside it on wide screens.
 */
interface Props {
  kicker: string;
  title: string;
  lede?: string;
  accent?: string;
}
const { kicker, title, lede, accent = "brand" } = Astro.props;
---

<header class:list={["page-head", `accent-${accent}`]}>
  <div class="container">
    <slot name="above" />
    <div class="page-head__grid">
      <div>
        <p class="eyebrow eyebrow--dot">{kicker}</p>
        <h1>{title}</h1>
      </div>
      {lede && <p class="lede">{lede}</p>}
    </div>
    <slot />
  </div>
</header>
