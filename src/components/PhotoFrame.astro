---
import { ImageOff } from "lucide-astro";
import type { Accent } from "../data/types";

interface Props {
  /** Real image, if one exists. */
  src?: string;
  alt?: string;
  /** Caption shown under the frame. */
  caption?: string;
  /** Frame aspect ratio, e.g. "4 / 3", "3 / 2", "1 / 1". */
  ratio?: string;
  /** Payload focal point (percent) — keeps the subject in frame when cropped. */
  focal?: { x: number; y: number };
  /** Make the image open in the lightbox. */
  lightbox?: boolean;
  lightboxGroup?: string;
  accent?: Accent;
  class?: string;
}

const {
  src,
  alt = "",
  caption,
  ratio = "4 / 3",
  focal,
  lightbox = false,
  lightboxGroup,
  accent = "brand",
  class: className,
} = Astro.props;

const objectPosition = focal ? `${focal.x}% ${focal.y}%` : "50% 50%";
const captionText = caption ?? alt;
---

<figure class:list={["frame", `accent-${accent}`, className]}>
  {src ? (
    lightbox ? (
      <button
        type="button"
        class="trigger"
        data-lightbox={src}
        data-lightbox-group={lightboxGroup}
        data-caption={captionText}
        aria-label={`${alt || captionText} — open larger`}
      >
        <img
          src={src}
          alt={alt}
          loading="lazy"
          decoding="async"
          style={`aspect-ratio:${ratio};object-fit:cover;object-position:${objectPosition};width:100%`}
        />
      </button>
    ) : (
      <img
        src={src}
        alt={alt}
        loading="lazy"
        decoding="async"
        style={`aspect-ratio:${ratio};object-fit:cover;object-position:${objectPosition};width:100%`}
      />
    )
  ) : (
    <div
      class="empty"
      style={`aspect-ratio:${ratio}`}
      role="img"
      aria-label={caption ?? "Photograph to be added"}
    >
      <ImageOff size={22} stroke-width={1.4} aria-hidden="true" />
    </div>
  )}
  {caption && <figcaption class="caption">{caption}</figcaption>}
</figure>

<style>
  .frame {
    margin: 0;
    border: 1px solid var(--rule);
    background: var(--paper-raised);
    border-radius: var(--r-2);
    overflow: hidden;
  }
  img {
    display: block;
  }
  .trigger {
    display: block;
    width: 100%;
    padding: 0;
    border: 0;
    background: none;
    cursor: zoom-in;
  }
  .trigger:hover img {
    opacity: 0.94;
  }
  .empty {
    display: grid;
    place-items: center;
    background: var(--paper-sunk);
    color: var(--ink-3);
    font-family: var(--font-mono);
    position: relative;
  }
  .empty::after {
    content: "";
    position: absolute;
    inset: 10px;
    border: 1px dashed color-mix(in oklab, var(--ink-3) 45%, transparent);
    border-radius: var(--r-1);
  }
  .caption {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-3);
    padding: var(--s-2) var(--s-3);
    border-top: 1px solid var(--rule);
    background: var(--paper-raised);
  }
</style>
