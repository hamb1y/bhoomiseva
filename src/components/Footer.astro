---
import type { Lang } from "../i18n/ui";
import { useTranslations, localePath } from "../i18n/utils";
import { pick, site } from "../data/site";
import { footerNav } from "../lib/nav";
import { Mail, Phone, MessageCircle, Facebook } from "lucide-astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const year = new Date().getFullYear();

const explore = footerNav.map((item) => ({
  label: t(item.key),
  href: localePath(item.href, lang),
}));

const socials = [
  { label: "WhatsApp", href: site.whatsapp, Icon: MessageCircle },
  { label: "Facebook", href: site.socials.facebook, Icon: Facebook },
].filter(({ href }) => Boolean(href));
---

<footer class="site-foot soil">
  <div class="container">
    <div class="top">
      <p class="tagline">{t("site.tagline")}</p>
      <p class="mission">{pick(site.mission, lang)}</p>
    </div>

    <div class="cols">
      <div class="col">
        <h2 class="head">{t("footer.explore")}</h2>
        <ul class="explore">
          {explore.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))}
        </ul>
      </div>

      <div class="col">
        <h2 class="head">{t("footer.contact")}</h2>
        <ul>
          <li>
            <a href={`mailto:${site.email}`}>
              <Mail size={16} stroke-width={1.6} aria-hidden="true" />
              {site.email}
            </a>
          </li>
          <li>
            <a href={`tel:${site.phoneHref}`}>
              <Phone size={16} stroke-width={1.6} aria-hidden="true" />
              {site.phone}
            </a>
          </li>
          <li>
            <a href={site.whatsapp}>
              <MessageCircle size={16} stroke-width={1.6} aria-hidden="true" />
              WhatsApp
            </a>
          </li>
        </ul>
      </div>

      <div class="col">
        <h2 class="head">{t("footer.follow")}</h2>
        <ul>
          {socials.map(({ label, href, Icon }) => (
            <li>
              <a href={href}>
                <Icon size={16} stroke-width={1.6} aria-hidden="true" />
                {label}
              </a>
            </li>
          ))}
        </ul>
      </div>
    </div>
  </div>

  <div class="container">
    <div class="foot">
      <span>
        © {year} {t("site.name")}
      </span>
      <span class="note">{t("footer.legal")}</span>
      <span class="credit">
        {t("footer.credit")}{" "}
        {site.creditUrl ? (
          <a href={site.creditUrl} rel="noopener noreferrer">
            {site.credit}
          </a>
        ) : (
          site.credit
        )}
      </span>
    </div>
  </div>
</footer>

<style>
  .site-foot {
    padding-top: var(--section);
  }
  .top {
    display: grid;
    grid-template-columns: minmax(0, 1.2fr) minmax(0, 1fr);
    gap: var(--s-6) clamp(2rem, 6vw, 5rem);
    align-items: end;
    padding-bottom: var(--s-8);
    border-bottom: 1px solid var(--soil-rule);
  }
  .tagline {
    font-family: var(--font-display);
    font-size: var(--step-4);
    line-height: 1.02;
    letter-spacing: -0.03em;
    max-width: 16ch;
    margin: 0;
    text-wrap: balance;
  }
  .mission {
    color: var(--on-soil-2);
    margin: 0;
    max-width: 46ch;
  }
  .cols {
    display: grid;
    grid-template-columns: 1.4fr 1fr 1fr;
    gap: var(--s-6);
    padding-block: var(--s-7) var(--s-6);
  }
  .head {
    font-family: var(--font-body);
    font-size: var(--step--1);
    font-weight: 600;
    letter-spacing: 0.01em;
    color: var(--on-soil-3);
    margin-bottom: var(--s-4);
  }
  ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: var(--s-3);
  }
  .explore {
    grid-template-columns: repeat(2, max-content);
    column-gap: var(--s-7);
  }
  .col a {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    text-decoration: none;
    color: var(--on-soil);
    font-size: var(--step-0);
    transition: color var(--dur-1) var(--ease-out);
  }
  .col a :global(svg) {
    color: var(--on-soil-3);
  }
  .col a:hover {
    color: var(--clay-bright);
  }
  .foot {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3) var(--s-6);
    justify-content: space-between;
    align-items: baseline;
    border-top: 1px solid var(--soil-rule);
    padding-block: var(--s-5);
    font-family: var(--font-mono);
    font-stretch: 82%;
    font-variant-numeric: tabular-nums;
    font-size: var(--step--1);
    color: var(--on-soil-3);
  }
  .credit a {
    color: var(--on-soil-2);
  }
  .credit a:hover {
    color: var(--clay-bright);
  }
  @media (max-width: 56rem) {
    .top {
      grid-template-columns: 1fr;
    }
    .cols {
      grid-template-columns: 1fr 1fr;
    }
    .cols .col:first-child {
      grid-column: 1 / -1;
    }
  }
  @media (max-width: 30rem) {
    .cols {
      grid-template-columns: 1fr;
    }
  }
</style>
