---
import type { Lang } from "../i18n/ui";
import { useTranslations, localePath } from "../i18n/utils";
import { nav, barePath } from "../lib/nav";
import Mark from "./Mark.astro";
import MobileNav from "./MobileNav.svelte";
import NavMenu from "./NavMenu.svelte";

interface Props {
  lang: Lang;
}

const { lang } = Astro.props;
const t = useTranslations(lang);
const path = barePath(Astro.url.pathname);
const otherLang: Lang = lang === "en" ? "kn" : "en";

const isActive = (href: string) => (href === "/" ? path === "/" : path.startsWith(href));

const desktop = nav;
const mobileLinks = nav.map((item) => ({
  label: t(item.key),
  href: localePath(item.href, lang),
  children: item.children?.map((child) => ({
    label: t(child.key),
    href: localePath(child.href, lang),
    accent: child.accent,
  })),
}));
---

<header class="site-head">
  <div class="container bar">
    <a class="brand" href={localePath("/", lang)}>
      <Mark size={36} />
      <span class="name">{t("site.name")}</span>
    </a>

    <nav class="primary" aria-label={t("nav.menu")}>
      <ul>
        {desktop.map((item) =>
          item.children?.length ? (
            <NavMenu
              client:load
              label={t(item.key)}
              href={localePath(item.href, lang)}
              active={isActive(item.href)}
              menuLabel={`${t(item.key)} — ${t("nav.menu")}`}
              items={item.children.map((child) => ({
                label: t(child.key),
                href: localePath(child.href, lang),
                accent: child.accent,
              }))}
            />
          ) : (
            <li>
              <a
                href={localePath(item.href, lang)}
                class:list={{ active: isActive(item.href) }}
                aria-current={isActive(item.href) ? "page" : undefined}
              >
                {t(item.key)}
              </a>
            </li>
          ),
        )}
      </ul>
    </nav>

    <div class="actions">
      <a class="lang" href={localePath(path, otherLang)} aria-label={t("lang.switchAria")}>
        {t("lang.switch")}
      </a>
      <a class="btn btn--primary donate" href={localePath("/donate", lang)}>
        {t("cta.donate")}
      </a>
      <div class="mobile">
        <MobileNav
          client:load
          links={mobileLinks}
          donateHref={localePath("/donate", lang)}
          donateLabel={t("cta.donate")}
          menuLabel={t("nav.menu")}
          closeLabel={t("nav.close")}
          langHref={localePath(path, otherLang)}
          langLabel={t("lang.switch")}
          langAria={t("lang.switchAria")}
        />
      </div>
    </div>
  </div>
</header>

<style>
  .site-head {
    position: sticky;
    top: 0;
    z-index: 70;
    background: color-mix(in oklab, var(--paper) 97%, transparent);
    border-bottom: 1px solid transparent;
  }
  /* Where supported, the bar gains its hairline only once the page scrolls. */
  @supports (animation-timeline: scroll()) {
    .site-head {
      animation: settle linear both;
      animation-timeline: scroll();
      animation-range: 0 6rem;
    }
  }
  @supports not (animation-timeline: scroll()) {
    .site-head {
      border-bottom-color: var(--rule);
    }
  }
  @keyframes settle {
    to {
      border-bottom-color: var(--rule);
      box-shadow: 0 12px 24px -22px rgba(36, 26, 19, 0.6);
    }
  }
  .bar {
    display: flex;
    align-items: center;
    gap: var(--s-6);
    min-height: var(--head-h);
  }
  .brand {
    display: inline-flex;
    align-items: center;
    gap: 0.7rem;
    text-decoration: none;
    color: var(--ink);
    margin-right: auto;
  }
  .brand :global(.mark) {
    transition: transform var(--dur-3) var(--ease-out);
  }
  .brand:hover :global(.mark) {
    transform: rotate(-12deg);
  }
  .name {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 30,
      "WONK" 1,
      "SOFT" 60;
    font-weight: 620;
    font-size: var(--step-1);
    letter-spacing: -0.02em;
    white-space: nowrap;
  }
  .primary ul {
    display: flex;
    align-items: center;
    gap: var(--s-1);
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .primary a {
    white-space: nowrap;
    display: inline-block;
    text-decoration: none;
    font-size: var(--step-0);
    font-weight: 500;
    color: var(--ink-2);
    padding: 0.45rem 0.75rem;
    border-radius: var(--r-3);
    transition:
      background var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }
  .primary a:hover {
    color: var(--ink);
    background: var(--ink-wash);
  }
  .primary a.active {
    color: var(--ink);
    background: var(--paper-sunk);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: var(--s-3);
  }
  .lang {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
    text-decoration: none;
    padding: 0.4rem 0.75rem;
    text-decoration: underline;
    text-underline-offset: 0.3em;
    transition:
      border-color var(--dur-1) var(--ease-out),
      color var(--dur-1) var(--ease-out);
  }
  .lang:hover {
    color: var(--clay-deep);
    border-color: var(--clay);
  }
  .donate {
    padding: 0.75em 1.2em;
  }
  .mobile {
    display: none;
  }
  @media (max-width: 72rem) {
    .primary,
    .lang {
      display: none;
    }
    /* The one action stays in the bar, not only inside the menu. */
    .mobile {
      display: block;
    }
    .bar {
      gap: var(--s-3);
    }
    .donate {
      padding: 0.6em 1em;
    }
  }
  @media (max-width: 26rem) {
    .name {
      display: none;
    }
  }
</style>
