---
import type { Lang } from "../i18n/ui";
import { useTranslations, localePath, lx } from "../i18n/utils";
import { formatDate } from "../utils/format";
import { programById } from "../data/programs";
import type { Story } from "../data/types";
import { ArrowUpRight } from "lucide-astro";

interface Props {
  story: Story;
  lang: Lang;
  lead?: boolean;
  showProgram?: boolean;
}

const { story, lang, lead = false, showProgram = true } = Astro.props;
const t = useTranslations(lang);
const program = programById(story.program);
const href = localePath(`/stories/${story.slug}`, lang);

const meta = story.date
  ? formatDate(story.date, lang)
  : story.period
    ? lx(story.period, lang)
    : null;
---

<article class:list={["card", `accent-${program?.accent ?? "brand"}`, { lead }]}>
  {story.image && (
    <img
      class="thumb"
      src={story.image}
      alt={story.imageAlt ? lx(story.imageAlt, lang) : ""}
      loading="lazy"
      decoding="async"
    />
  )}
  <div class="meta">
    <span class="date">{meta ?? t("common.dateUnknown")}</span>
    {showProgram && <span class="prog">{lx(program?.kicker ?? "", lang)}</span>}
  </div>

  <h3 class="title">
    <a href={href}>
      {lx(story.title, lang)}
      <ArrowUpRight size={lead ? 22 : 17} stroke-width={1.6} aria-hidden="true" />
    </a>
  </h3>

  <p class="summary">{lx(story.summary, lang)}</p>

  <p class="place">{lx(story.location, lang)}</p>
</article>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: var(--s-3);
    padding-block: var(--s-5);
    border-top: 1px solid var(--rule);
    position: relative;
  }
  .thumb {
    width: 100%;
    aspect-ratio: 3 / 2;
    object-fit: cover;
    border: 1px solid var(--rule);
    border-radius: var(--r-2);
    background: var(--paper-sunk);
  }
  .meta {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  .date {
    color: var(--ink-2);
  }
  .prog {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
  }
  .prog::before {
    content: "";
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent);
    flex: none;
  }
  .title {
    margin: 0;
    font-size: var(--step-2);
    line-height: 1.12;
  }
  .lead .title {
    font-size: var(--step-3);
  }
  .title a {
    text-decoration: none;
    display: inline;
    background-image: linear-gradient(currentColor, currentColor);
    background-repeat: no-repeat;
    background-position: 0 100%;
    background-size: 0% 1px;
    transition: background-size var(--dur-2) var(--ease-out);
  }
  .title a:hover {
    background-size: 100% 1px;
  }
  .title svg {
    display: inline-block;
    vertical-align: baseline;
    margin-left: 0.15em;
    color: var(--accent);
    transition: transform var(--dur-2) var(--ease-out);
  }
  .title a:hover svg {
    transform: translate(2px, -2px);
  }
  .summary {
    margin: 0;
    color: var(--ink-2);
    max-width: 60ch;
  }
  .lead .summary {
    font-size: var(--step-1);
  }
  .place {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
</style>
