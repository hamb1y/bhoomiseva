---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, localePath, lx } from "../i18n/utils";
import { programById } from "../data/programs";
import { storyBySlug, storiesByProgram } from "../data/stories";
import type { Story } from "../data/types";
import { formatDate } from "../utils/format";
import StoryCard from "../components/StoryCard.astro";
import PhotoFrame from "../components/PhotoFrame.astro";
import CTABand from "../components/CTABand.astro";
import { ArrowLeft } from "lucide-astro";

interface Props {
  lang: Lang;
  slug: string;
}
const { lang, slug } = Astro.props;
const t = useTranslations(lang);
const story = storyBySlug(slug) as Story;
const program = programById(story.program)!;

const related = storiesByProgram(story.program)
  .filter((s) => s.slug !== story.slug)
  .slice(0, 2);

const dateLabel = story.date
  ? formatDate(story.date, lang)
  : story.period
    ? lx(story.period, lang)
    : t("common.dateUnknown");

const rows = [
  { label: t("common.programme"), value: lx(program.kicker, lang) },
  { label: story.date ? t("common.dated") : t("story.period"), value: dateLabel },
  { label: t("common.location"), value: lx(story.location, lang) },
];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: lx(story.title, "en"),
  description: lx(story.summary, "en"),
  inLanguage: lang,
  about: lx(program.kicker, "en"),
  locationCreated: lx(story.location, "en"),
};
---

<BaseLayout
  lang={lang}
  path={`/stories/${story.slug}`}
  title={lx(story.title, lang)}
  description={lx(story.summary, lang)}
  jsonLd={jsonLd}
>
  <article class:list={["story", `accent-${program.accent}`]} data-lang={lang}>
    <div class="container narrow">
      <a class="back" href={localePath("/stories", lang)}>
        <ArrowLeft size={15} stroke-width={1.7} aria-hidden="true" />
        {t("common.backToStories")}
      </a>

      <p class="eyebrow">{lx(program.kicker, lang)}</p>
      <h1>{lx(story.title, lang)}</h1>
      <p class="summary">{lx(story.summary, lang)}</p>

      <ul class="ledger meta">
        {rows.map((row) => (
          <li>
            <span class="label">{row.label}</span>
            <span class="value">{row.value}</span>
          </li>
        ))}
      </ul>

      <PhotoFrame caption={lx(story.location, lang)} ratio="16 / 9" accent={program.accent} />

      <div class="body">
        {story.body.map((p) => (
          <p>{lx(p, lang)}</p>
        ))}
      </div>

      {story.quote ? (
        <figure class="quote">
          <p class="quote-label">{t("story.quoteLabel")}</p>
          <blockquote>{lx(story.quote.text, lang)}</blockquote>
          <figcaption>— {lx(story.quote.attribution, lang)}</figcaption>
        </figure>
      ) : null}

      {story.people?.length ? (
        <div class="people">
          <p class="eyebrow">{t("story.people")}</p>
          <ul>
            {story.people.map((person) => (
              <li>{person}</li>
            ))}
          </ul>
        </div>
      ) : null}
    </div>
  </article>

  {related.length ? (
    <section class="related">
      <div class="container">
        <h2>{t("common.relatedStories")}</h2>
        <div class="related-grid">
          {related.map((s) => (
            <StoryCard story={s} lang={lang} />
          ))}
        </div>
      </div>
    </section>
  ) : null}

  <CTABand
    lang={lang}
    kicker={t("home.impact.kicker")}
    title={t("home.impact.title")}
    body={t("home.impact.body")}
  />
</BaseLayout>

<style>
  .story {
    padding-top: var(--s-6);
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-2);
    margin-bottom: var(--s-6);
  }
  .back:hover {
    color: var(--accent);
  }
  h1 {
    margin: var(--s-4) 0 0;
  }
  .summary {
    font-size: var(--step-1);
    color: var(--ink-2);
    margin: var(--s-5) 0 var(--s-7);
  }
  .meta {
    margin-bottom: var(--s-7);
  }
  .body {
    margin-top: var(--s-7);
    display: grid;
    gap: var(--s-5);
    font-size: var(--step-1);
    line-height: 1.65;
  }
  .body p {
    margin: 0;
  }
  [data-lang="en"] .body p:first-child::first-letter {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 80,
      "WONK" 1;
    font-size: 3.4em;
    line-height: 0.82;
    float: left;
    padding: 0.06em 0.12em 0 0;
    color: var(--accent);
  }
  .quote {
    margin: var(--s-7) 0 0;
    padding: var(--s-5) 0 0 var(--s-5);
    border-top: 1px solid var(--rule-strong);
    border-left: 3px solid var(--accent);
  }
  .quote-label {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    letter-spacing: 0.12em;
    text-transform: uppercase;
    color: var(--ink-3);
    margin: 0 0 var(--s-3);
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 30,
      "WONK" 1,
      "SOFT" 40;
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink);
  }
  .quote figcaption {
    margin-top: var(--s-4);
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .people {
    margin-top: var(--s-7);
    padding-top: var(--s-5);
    border-top: 1px solid var(--rule);
  }
  .people ul {
    list-style: none;
    padding: 0;
    margin: var(--s-3) 0 0;
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
  }
  .people li {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    border: 1px solid var(--rule-strong);
    border-radius: 999px;
    padding: 0.25em 0.9em;
    color: var(--ink-2);
  }
  .related .container {
    border-top: 1px solid var(--rule-strong);
    padding-top: var(--s-6);
  }
  .related h2 {
    font-size: var(--step-2);
    margin-bottom: var(--s-6);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--s-6) var(--s-7);
  }
</style>
