---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { site } from "../data/site";
import LeadForm from "../components/LeadForm.svelte";
import PageHead from "../components/PageHead.astro";
import { Mail, Phone, MessageCircle, Facebook } from "lucide-astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const fields = [
  { name: "name", label: t("form.name"), required: true },
  { name: "email", label: t("form.email"), type: "email" as const, required: true },
  { name: "message", label: t("form.message"), type: "textarea" as const, required: true },
];
---

<BaseLayout lang={lang} path="/contact" title={t("nav.contact")} description={t("contact.lede")}>
  <PageHead kicker={t("contact.kicker")} title={t("contact.title")} lede={t("contact.lede")} />

  <section class="body">
    <div class="container grid">
      <div class="form-col">
        <h2>{t("contact.form.title")}</h2>
        <LeadForm
          client:load
          formName="Contact"
          fields={fields}
          fallbackWhatsapp={site.whatsapp}
          fallbackEmail={site.email}
          submitLabel={t("form.submit")}
          sendingLabel={t("form.sending")}
          successMessage={t("form.success")}
          errorMessage={t("form.error")}
          invalidEmailMessage={t("form.invalidEmail")}
          orContactLabel={t("form.orContact")}
          contactEmail={site.email}
          contactWhatsapp={site.whatsapp}
        />
      </div>

      <aside class="details soil">
        <h2>{t("footer.contact")}</h2>
        <ul>
          <li>
            <span class="label">{t("contact.email")}</span>
            <a class="value" href={`mailto:${site.email}`}>
              <Mail size={20} stroke-width={1.6} aria-hidden="true" />
              {site.email}
            </a>
          </li>
          <li>
            <span class="label">{t("contact.phone")}</span>
            <a class="value" href={`tel:${site.phoneHref}`}>
              <Phone size={20} stroke-width={1.6} aria-hidden="true" />
              {site.phone}
            </a>
          </li>
          <li>
            <span class="label">WhatsApp</span>
            <a class="value" href={site.whatsapp}>
              <MessageCircle size={20} stroke-width={1.6} aria-hidden="true" />
              +91 9900103178
            </a>
          </li>
          {site.socials.facebook && (
            <li>
              <span class="label">{t("contact.socials")}</span>
              <a class="value" href={site.socials.facebook}>
                <Facebook size={20} stroke-width={1.6} aria-hidden="true" />
                Facebook
              </a>
            </li>
          )}
        </ul>
      </aside>
    </div>
  </section>
</BaseLayout>

<style>
  .body {
    padding-top: 0;
  }
  .grid {
    display: grid;
    grid-template-columns: minmax(0, 1.3fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: start;
  }
  .form-col {
    background: var(--paper-raised);
    border-radius: var(--r-4);
    padding: clamp(1.5rem, 4vw, 3rem);
    box-shadow: var(--shadow-lift);
  }
  .form-col h2,
  .details h2 {
    font-size: var(--step-3);
    margin: 0 0 var(--s-6);
  }
  .details {
    border-radius: var(--r-4);
    padding: clamp(1.5rem, 4vw, 3rem);
  }
  .details ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
  }
  .details li {
    display: grid;
    gap: var(--s-2);
    padding-block: var(--s-4);
    border-top: 1px solid var(--soil-rule);
  }
  .label {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--on-soil-3);
  }
  .value {
    display: inline-flex;
    align-items: center;
    gap: var(--s-3);
    font-size: var(--step-1);
    font-weight: 500;
    color: var(--on-soil);
    text-decoration: none;
    overflow-wrap: anywhere;
    transition: color var(--dur-1) var(--ease-out);
  }
  .value :global(svg) {
    flex: none;
    color: var(--clay-bright);
  }
  .value:hover {
    color: var(--clay-bright);
  }
  @media (max-width: 62rem) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
</style>
