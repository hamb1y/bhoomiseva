---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, lx } from "../i18n/utils";
import { pick, site } from "../data/site";
import { team } from "../data/team";
import CTABand from "../components/CTABand.astro";
import { objectPosition } from "../utils/format";
import { Info } from "lucide-astro";
import { existsSync } from "node:fs";
import { asset } from "../utils/url";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const hasLogo = existsSync("public/images/logo.webp");
---

<BaseLayout lang={lang} path="/about" title={t("nav.about")} description={t("about.lede")}>
  <header class="page-head">
    <div class="container head-grid">
      <div>
        <p class="eyebrow eyebrow--dot">{t("about.kicker")}</p>
        <h1>{t("about.title")}</h1>
        <p class="lede head-lede">{t("about.lede")}</p>
      </div>
      {hasLogo && (
        <div class="lockup-wrap">
          <svg class="sun" viewBox="0 0 200 200" aria-hidden="true">
            <circle cx="100" cy="100" r="100"></circle>
          </svg>
          <img
            class="lockup"
            src={asset("/images/logo.webp")}
            alt="Bhoomi Seva"
            width="240"
            height="354"
          />
        </div>
      )}
    </div>
  </header>

  <section class="intro">
    <div class="container">
      <div class="intro-grid">
        {site.about.map((p, i) => (
          <p class:list={{ first: i === 0 }}>{pick(p, lang)}</p>
        ))}
      </div>
    </div>
  </section>

  <section class="mv soil">
    <div class="container mv-grid">
      <div class="mv-block">
        <p class="eyebrow eyebrow--dot">{t("about.mission")}</p>
        <p class="mv-text">{pick(site.mission, lang)}</p>
      </div>
      <div class="mv-block accent-farmers">
        <p class="eyebrow eyebrow--dot">{t("about.vision")}</p>
        <p class="mv-text">{pick(site.vision, lang)}</p>
      </div>
    </div>
  </section>

  <section class="team">
    <div class="container">
      <div class="team-head">
        <div>
          <h2>{t("about.team")}</h2>
          <p class="sub">{t("about.team.lede")}</p>
        </div>
        <div class="aside">
          <Info size={20} stroke-width={1.7} aria-hidden="true" />
          <p>{t("about.disclaimer")}</p>
        </div>
      </div>

      <ul class="people">
        {team.map((person) => (
          <li class="reveal">
            <div class="portrait">
              {person.photo && (
                <img
                  src={person.photo}
                  alt={person.name}
                  style={`object-position:${objectPosition(person.photoFocal)}`}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <h3>{person.name}</h3>
            <p class="role">{lx(person.role, lang)}</p>
            <p class="bio">{lx(person.bio, lang)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="community">
    <div class="container">
      <div class="community-inner">
        <h2>{t("about.community")}</h2>
        <p>{t("about.community.body")}</p>
      </div>
    </div>
  </section>

  <CTABand
    lang={lang}
    kicker={t("involved.kicker")}
    title={t("involved.title")}
    body={t("involved.lede")}
  />
</BaseLayout>

<style>
  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(0, 0.7fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .page-head h1 {
    max-width: 12ch;
  }
  .page-head .head-grid .head-lede {
    margin-top: var(--s-6);
    max-width: 52ch;
  }
  .lockup-wrap {
    position: relative;
    display: grid;
    place-items: center;
    padding: var(--s-6);
  }
  .sun {
    position: absolute;
    width: 100%;
    max-width: 22rem;
    fill: var(--paper-raised);
  }
  .lockup {
    position: relative;
    width: clamp(9rem, 16vw, 13rem);
    height: auto;
  }

  .intro {
    padding-top: 0;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) clamp(2rem, 5vw, 4rem);
    padding-top: var(--s-7);
    border-top: 1px solid var(--rule-strong);
  }
  .intro p {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--step-0);
    line-height: 1.7;
  }
  .intro p.first {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 60,
      "WONK" 1,
      "SOFT" 60;
    font-weight: 420;
    font-size: var(--step-3);
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 30ch;
  }
  :global(:lang(kn)) .intro p.first {
    font-size: var(--step-2);
    line-height: 1.5;
    letter-spacing: 0;
  }

  .mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .mv-block + .mv-block {
    padding-left: clamp(2.5rem, 6vw, 5rem);
    border-left: 1px solid var(--soil-rule);
  }
  .mv-text {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 60,
      "WONK" 1,
      "SOFT" 60;
    font-weight: 420;
    font-size: var(--step-3);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: var(--s-5) 0 0;
    text-wrap: pretty;
  }
  :global(:lang(kn)) .mv-text {
    font-size: var(--step-2);
    line-height: 1.5;
    letter-spacing: 0;
  }

  .team-head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--s-6) clamp(2rem, 5vw, 4rem);
    align-items: end;
    margin-bottom: var(--s-8);
  }
  .team-head h2 {
    font-size: var(--step-5);
    margin: 0;
  }
  .sub {
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
    margin-top: var(--s-4);
    max-width: 44ch;
  }
  .aside {
    display: flex;
    gap: var(--s-3);
    border-radius: var(--r-4);
    background: var(--turmeric-wash);
    padding: var(--s-5);
  }
  .aside :global(svg) {
    flex: none;
    color: #8a6112;
    margin-top: 0.15em;
  }
  .aside p {
    margin: 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--s-8) var(--s-6);
  }
  .portrait {
    border-radius: var(--r-4);
    overflow: hidden;
    background: var(--paper-sunk);
    margin-bottom: var(--s-4);
  }
  .portrait img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    filter: var(--photo-filter);
  }
  .people h3 {
    font-size: var(--step-2);
    margin: 0;
  }
  .role {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--clay-deep);
    margin: var(--s-2) 0 var(--s-3);
  }
  .bio {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .community {
    padding-top: 0;
  }
  .community-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: var(--s-5) clamp(2rem, 5vw, 4rem);
    align-items: baseline;
    padding: clamp(2rem, 5vw, 3.5rem);
    background: var(--leaf-wash);
    border-radius: var(--r-4);
  }
  .community h2 {
    font-size: var(--step-4);
    margin: 0;
  }
  .community p {
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.55;
    margin: 0;
  }
  @media (max-width: 62rem) {
    .head-grid,
    .mv-grid,
    .team-head,
    .intro-grid,
    .community-inner {
      grid-template-columns: 1fr;
    }
    .mv-block + .mv-block {
      padding-left: 0;
      border-left: 0;
      padding-top: var(--s-6);
      border-top: 1px solid var(--soil-rule);
    }
    .lockup-wrap {
      justify-self: start;
    }
  }
</style>
