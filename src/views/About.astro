---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, lx } from "../i18n/utils";
import { pick, site } from "../data/site";
import { team } from "../data/team";
import CTABand from "../components/CTABand.astro";
import { objectPosition } from "../utils/format";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const [lead, ...record] = site.aboutPhotos;
const month = (value: string) =>
  value
    ? new Date(`${value}-01T00:00:00`).toLocaleDateString(lang === "kn" ? "kn-IN" : "en-IN", {
        month: "long",
        year: "numeric",
      })
    : "";
---

<BaseLayout lang={lang} path="/about" title={t("nav.about")} description={t("about.lede")}>
  <header class="page-head">
    <div class="container head-grid">
      <div>
        <h1>{t("about.title")}</h1>
        <p class="lede head-lede">{t("about.lede")}</p>
      </div>
      {lead && (
        <figure class="lead">
          <img src={lead.image} alt={lx(lead.caption, lang)} width="1280" height="960" />
          <figcaption>
            {lx(lead.caption, lang)} <span>{month(lead.date)}</span>
          </figcaption>
        </figure>
      )}
    </div>
  </header>

  <section class="intro">
    <div class="container">
      <div class="intro-grid">
        {site.about.map((p, i) => (
          <p class:list={{ first: i === 0 }}>{pick(p, lang)}</p>
        ))}
      </div>
    </div>
  </section>

  {record.length > 0 && (
    <section class="record">
      <div class="container">
        <div class="record-head">
          <h2>{t("about.record")}</h2>
          <p>{t("about.record.lede")}</p>
        </div>
        <ul class="mosaic">
          {record.map((photo) => (
            <li>
              <figure>
                <img src={photo.image} alt={lx(photo.caption, lang)} loading="lazy" decoding="async" />
                <figcaption>
                  {lx(photo.caption, lang)} <span>{month(photo.date)}</span>
                </figcaption>
              </figure>
            </li>
          ))}
        </ul>
      </div>
    </section>
  )}

  <section class="mv soil">
    <div class="container mv-grid">
      <div class="mv-block">
        <p class="eyebrow">{t("about.mission")}</p>
        <p class="mv-text">{pick(site.mission, lang)}</p>
      </div>
      <div class="mv-block accent-farmers">
        <p class="eyebrow">{t("about.vision")}</p>
        <p class="mv-text">{pick(site.vision, lang)}</p>
      </div>
    </div>
  </section>

  <section class="team">
    <div class="container">
      <div class="team-head">
        <div>
          <h2>{t("about.team")}</h2>
          <p class="sub">{t("about.team.lede")}</p>
        </div>
      </div>

      <ul class="people">
        {team.map((person) => (
          <li class="reveal">
            <div class="portrait">
              {person.photo && (
                <img
                  src={person.photo}
                  alt={person.name}
                  style={`object-position:${objectPosition(person.photoFocal)}`}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <h3>{person.name}</h3>
            <p class="role">{lx(person.role, lang)}</p>
            <p class="bio">{lx(person.bio, lang)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <section class="community">
    <div class="container">
      <div class="community-inner">
        <h2>{t("about.community")}</h2>
        <p>{t("about.community.body")}</p>
      </div>
    </div>
  </section>

  <CTABand
    lang={lang}
    kicker={t("involved.kicker")}
    title={t("involved.title")}
    body={t("home.impact.body")}
  />
</BaseLayout>

<style>
  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.05fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .page-head h1 {
    max-width: 12ch;
  }
  .page-head .head-grid .head-lede {
    margin-top: var(--s-6);
    max-width: 52ch;
  }
  .lead {
    margin: 0;
  }
  .lead img,
  .mosaic img {
    display: block;
    width: 100%;
    object-fit: cover;
    border-radius: var(--r-4);
    filter: var(--photo-filter);
  }
  .lead img {
    height: auto;
    aspect-ratio: 4 / 3;
  }
  figcaption {
    margin-top: var(--s-3);
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink);
  }
  figcaption span {
    font-weight: 400;
    color: var(--ink-3);
    margin-left: 0.4em;
  }

  .record-head {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: var(--s-4) clamp(2rem, 5vw, 4rem);
    align-items: end;
    margin-bottom: var(--s-7);
  }
  .record-head h2 {
    font-size: var(--step-5);
    margin: 0;
    max-width: 14ch;
  }
  .record-head p {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--step-1);
    max-width: 40ch;
  }
  .mosaic {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(12, minmax(0, 1fr));
    gap: var(--s-6) var(--s-5);
  }
  .mosaic figure {
    margin: 0;
  }
  /* Two wide photographs, then rows of four, so the rhythm changes as you read. */
  .mosaic li {
    grid-column: span 3;
  }
  .mosaic li:nth-child(1),
  .mosaic li:nth-child(2) {
    grid-column: span 6;
  }
  .mosaic img {
    aspect-ratio: 4 / 3;
  }

  .intro {
    padding-top: 0;
  }
  .intro-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: var(--s-6) clamp(2rem, 5vw, 4rem);
    padding-top: var(--s-7);
    border-top: 1px solid var(--rule-strong);
  }
  .intro p {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--step-0);
    line-height: 1.7;
  }
  .intro p.first {
    grid-column: 1 / -1;
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 60,
      "WONK" 1,
      "SOFT" 60;
    font-weight: 420;
    font-size: var(--step-3);
    line-height: 1.22;
    letter-spacing: -0.02em;
    color: var(--ink);
    max-width: 30ch;
  }
  :global(:lang(kn)) .intro p.first {
    font-size: var(--step-2);
    line-height: 1.5;
    letter-spacing: 0;
  }

  .mv-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2.5rem, 6vw, 5rem);
  }
  .mv-block + .mv-block {
    padding-left: clamp(2.5rem, 6vw, 5rem);
    border-left: 1px solid var(--soil-rule);
  }
  .mv-text {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 60,
      "WONK" 1,
      "SOFT" 60;
    font-weight: 420;
    font-size: var(--step-3);
    line-height: 1.2;
    letter-spacing: -0.02em;
    margin: var(--s-5) 0 0;
    text-wrap: pretty;
  }
  :global(:lang(kn)) .mv-text {
    font-size: var(--step-2);
    line-height: 1.5;
    letter-spacing: 0;
  }

  .team-head {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 1fr);
    gap: var(--s-6) clamp(2rem, 5vw, 4rem);
    align-items: end;
    margin-bottom: var(--s-8);
  }
  .team-head h2 {
    font-size: var(--step-5);
    margin: 0;
  }
  .sub {
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.5;
    margin-top: var(--s-4);
    max-width: 44ch;
  }

  .people {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
    gap: var(--s-8) var(--s-6);
  }
  .portrait {
    border-radius: var(--r-4);
    overflow: hidden;
    background: var(--paper-sunk);
    margin-bottom: var(--s-4);
  }
  .portrait img {
    width: 100%;
    aspect-ratio: 2 / 3;
    object-fit: cover;
    filter: var(--photo-filter);
  }
  .people h3 {
    font-size: var(--step-2);
    margin: 0;
  }
  .role {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--clay-deep);
    margin: var(--s-2) 0 var(--s-3);
  }
  .bio {
    margin: 0;
    color: var(--ink-2);
    font-size: var(--step--1);
    line-height: 1.6;
  }

  .community {
    padding-top: 0;
  }
  .community-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1.3fr);
    gap: var(--s-5) clamp(2rem, 5vw, 4rem);
    align-items: baseline;
    padding: clamp(2rem, 5vw, 3.5rem);
    background: var(--leaf-wash);
    border-radius: var(--r-4);
  }
  .community h2 {
    font-size: var(--step-4);
    margin: 0;
  }
  .community p {
    color: var(--ink-2);
    font-size: var(--step-1);
    line-height: 1.55;
    margin: 0;
  }
  @media (max-width: 62rem) {
    .head-grid,
    .mv-grid,
    .team-head,
    .intro-grid,
    .community-inner {
      grid-template-columns: 1fr;
    }
    .mv-block + .mv-block {
      padding-left: 0;
      border-left: 0;
      padding-top: var(--s-6);
      border-top: 1px solid var(--soil-rule);
    }
    .record-head {
      grid-template-columns: 1fr;
    }
    .mosaic {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .mosaic li,
    .mosaic li:nth-child(1),
    .mosaic li:nth-child(2) {
      grid-column: span 1;
    }
    .mosaic li:first-child {
      grid-column: 1 / -1;
    }
  }
</style>
