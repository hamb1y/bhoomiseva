---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, lx } from "../i18n/utils";
import { formatDate } from "../utils/format";
import { programById } from "../data/programs";
import type { Entry } from "../data/types";
import EntryCard from "../components/EntryCard.astro";
import PhotoFrame from "../components/PhotoFrame.astro";
import CTABand from "../components/CTABand.astro";
import { ArrowLeft } from "lucide-astro";

interface Props {
  lang: Lang;
  path: string;
  basePath: string;
  entry: Entry;
  accent?: string;
  backHref: string;
  backLabel: string;
  relatedLabel: string;
  related: Entry[];
  showProgram?: boolean;
  showAuthor?: boolean;
}

const {
  lang,
  path,
  basePath,
  entry,
  accent,
  backHref,
  backLabel,
  relatedLabel,
  related,
  showProgram = true,
  showAuthor = false,
} = Astro.props;

const t = useTranslations(lang);
const program = entry.program ? programById(entry.program) : undefined;
const accentClass = accent ?? program?.accent ?? "brand";

const dateLabel = entry.date
  ? formatDate(entry.date, lang)
  : entry.period
    ? lx(entry.period, lang)
    : t("common.dateUnknown");

const record = [
  showAuthor && entry.author ? { label: t("story.record.author"), value: entry.author } : null,
  showProgram && program
    ? { label: t("stories.filter.programme"), value: lx(program.kicker, lang), dot: true }
    : null,
  { label: t("story.record.date"), value: dateLabel },
  entry.location ? { label: t("story.record.place"), value: lx(entry.location, lang) } : null,
].filter(Boolean) as { label: string; value: string; dot?: boolean }[];

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "Article",
  headline: lx(entry.title, "en"),
  description: lx(entry.summary, "en"),
  inLanguage: lang,
  author: entry.author ? { "@type": "Person", name: entry.author } : undefined,
};
---

<BaseLayout
  lang={lang}
  path={path}
  title={lx(entry.title, lang)}
  description={lx(entry.summary, lang)}
  jsonLd={jsonLd}
>
  <article class:list={["entry", `accent-${accentClass}`]} data-lang={lang}>
    <header class="container entry-head">
      <a class="back" href={backHref}>
        <ArrowLeft size={16} stroke-width={1.8} aria-hidden="true" />
        {backLabel}
      </a>

      {entry.author && showAuthor && <p class="eyebrow eyebrow--dot">{entry.author}</p>}
      {!showAuthor && program && <p class="eyebrow eyebrow--dot">{lx(program.kicker, lang)}</p>}
      <h1>{lx(entry.title, lang)}</h1>
      <p class="summary">{lx(entry.summary, lang)}</p>

      <dl class="record">
        {record.map((item) => (
          <div>
            <dt>{item.label}</dt>
            <dd class:list={{ dot: item.dot }}>{item.value}</dd>
          </div>
        ))}
      </dl>
    </header>

    <div class="container photo-wrap">
      <PhotoFrame
        src={entry.image}
        alt={entry.imageAlt ? lx(entry.imageAlt, lang) : lx(entry.title, lang)}
        caption={entry.imageAlt ? lx(entry.imageAlt, lang) : ""}
        focal={entry.imageFocal}
        lightbox
        ratio="3 / 2"
        accent={accentClass as any}
      />
    </div>

    <div class="container prose">
      <div class="body">
        {entry.body.map((p) => (
          <p>{lx(p, lang)}</p>
        ))}
      </div>

      {entry.quote ? (
        <figure class="quote">
          <span class="mark" aria-hidden="true">
            “
          </span>
          <p class="quote-label">{t("story.quoteLabel")}</p>
          <blockquote>{lx(entry.quote.text, lang)}</blockquote>
          <figcaption>{lx(entry.quote.attribution, lang)}</figcaption>
        </figure>
      ) : null}

      {entry.people?.length ? (
        <p class="people">
          <span class="people-label">{t("story.people")}</span>
          {entry.people.map((name) => (
            <span class="person">{name}</span>
          ))}
        </p>
      ) : null}
    </div>
  </article>

  {related.length ? (
    <section class="related">
      <div class="container">
        <h2>{relatedLabel}</h2>
        <div class="related-grid">
          {related.map((r) => (
            <EntryCard
              entry={r}
              lang={lang}
              basePath={basePath}
              showProgram={showProgram}
              showAuthor={showAuthor}
            />
          ))}
        </div>
      </div>
    </section>
  ) : null}

  <CTABand
    lang={lang}
    kicker={t("home.impact.kicker")}
    title={t("home.impact.title")}
    body={t("home.impact.body")}
  />
</BaseLayout>

<style>
  .entry {
    padding-top: clamp(2rem, 5vw, 3.5rem);
  }
  .entry-head {
    max-width: 64rem;
  }
  .entry-head .eyebrow {
    display: flex;
  }
  .back {
    display: inline-flex;
    align-items: center;
    gap: 0.45rem;
    text-decoration: none;
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-2);
    margin-bottom: var(--s-7);
    text-decoration: underline;
    text-underline-offset: 0.3em;
    transition:
      color var(--dur-1) var(--ease-out),
      border-color var(--dur-1) var(--ease-out);
  }
  .back :global(svg) {
    transition: transform var(--dur-2) var(--ease-out);
  }
  .back:hover {
    color: var(--ink);
    border-color: var(--ink);
  }
  .back:hover :global(svg) {
    transform: translateX(-3px);
  }
  h1 {
    margin: var(--s-4) 0 0;
    font-size: var(--step-5);
    max-width: 18ch;
  }
  .summary {
    font-size: var(--step-2);
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 36,
      "WONK" 1,
      "SOFT" 60;
    font-weight: 380;
    line-height: 1.35;
    color: var(--ink-2);
    margin: var(--s-6) 0 0;
    max-width: 40ch;
  }
  :global(:lang(kn)) .summary {
    font-size: var(--step-1);
  }

  /* The record: who, what, when, where — set as data, not prose. */
  .record {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 12rem), 1fr));
    gap: 0;
    margin: var(--s-7) 0 var(--s-7);
    border-block: 1px solid var(--rule-strong);
  }
  .record > div {
    padding: var(--s-4) var(--s-5) var(--s-4) 0;
  }
  .record > div + div {
    padding-left: var(--s-5);
    border-left: 1px solid var(--rule);
  }
  dt {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--ink-3);
    margin-bottom: var(--s-1);
  }
  dd {
    margin: 0;
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink);
    line-height: 1.45;
  }
  @media (max-width: 40rem) {
    .record > div + div {
      padding-left: 0;
      border-left: 0;
      border-top: 1px solid var(--rule);
    }
  }

  .photo-wrap {
    max-width: 64rem;
  }

  .prose {
    max-width: calc(44rem + 2 * var(--gutter));
  }
  .body {
    margin-top: var(--s-8);
    display: grid;
    gap: var(--s-5);
    font-size: var(--step-1);
    line-height: 1.7;
  }
  .body p {
    margin: 0;
  }
  [data-lang="en"] .body p:first-child::first-letter {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 144,
      "WONK" 1,
      "SOFT" 100;
    font-weight: 600;
    font-size: 4.1em;
    line-height: 0.8;
    float: left;
    padding: 0.08em 0.1em 0 0;
    color: var(--accent);
  }

  .quote {
    position: relative;
    margin: var(--s-8) 0 0;
    padding: clamp(2rem, 5vw, 3.5rem);
    padding-top: clamp(3.5rem, 7vw, 5rem);
    background: var(--accent-wash);
    border-radius: var(--r-4);
  }
  .mark {
    position: absolute;
    top: -0.15em;
    left: clamp(1.25rem, 4vw, 2.75rem);
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 144,
      "SOFT" 100;
    font-weight: 700;
    font-size: clamp(6rem, 14vw, 9rem);
    line-height: 1;
    color: var(--accent-fill);
  }
  .quote-label {
    font-size: var(--step--1);
    font-weight: 600;
    color: var(--accent);
    margin: 0 0 var(--s-4);
  }
  .quote blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 30,
      "WONK" 1,
      "SOFT" 60;
    font-weight: 420;
    font-size: var(--step-2);
    line-height: 1.42;
    color: var(--ink);
  }
  :global(:lang(kn)) .quote blockquote {
    font-size: var(--step-1);
    line-height: 1.7;
  }
  .quote figcaption {
    display: flex;
    align-items: center;
    gap: var(--s-3);
    margin-top: var(--s-5);
    font-weight: 600;
    color: var(--ink-2);
  }
  .quote figcaption::before {
    content: "";
    width: 2rem;
    height: 2px;
    background: var(--accent-fill);
  }
  .people {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: var(--s-2);
    margin: var(--s-7) 0 0;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .people-label {
    font-weight: 600;
    color: var(--ink-3);
    margin-right: var(--s-2);
  }
  .person:not(:last-child)::after {
    content: ",";
  }
  .related h2 {
    font-size: var(--step-3);
    margin-bottom: var(--s-7);
  }
  .related-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--s-7) var(--s-6);
  }
</style>
