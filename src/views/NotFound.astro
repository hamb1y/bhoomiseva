---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, localePath } from "../i18n/utils";
import { nav } from "../lib/nav";
import { ArrowRight } from "lucide-astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const links = nav.map((item) => ({ label: t(item.key), href: localePath(item.href, lang) }));
---

<BaseLayout lang={lang} path="/404" title="404">
  <section class="notfound">
    <div class="container">
      <div class="copy">
        <p class="eyebrow">404</p>
        <h1>{t("notfound.title")}</h1>
        <p class="body">{t("notfound.body")}</p>

        <ul class="links">
          {links.map((link) => (
            <li>
              <a href={link.href}>
                {link.label}
                <ArrowRight size={16} stroke-width={1.8} aria-hidden="true" />
              </a>
            </li>
          ))}
        </ul>

        <a class="btn btn--primary" href={localePath("/", lang)}>
          {t("notfound.home")}
        </a>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .notfound {
    padding-block: clamp(3rem, 8vw, 7rem);
  }
  h1 {
    margin: var(--s-4) 0 var(--s-5);
    max-width: 14ch;
  }
  .body {
    color: var(--ink-2);
    font-size: var(--step-1);
    max-width: 44ch;
  }
  .links {
    list-style: none;
    padding: 0;
    margin: var(--s-7) 0;
    display: grid;
    border-top: 1px solid var(--rule);
  }
  .links a {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding-block: var(--s-3);
    border-bottom: 1px solid var(--rule);
    text-decoration: none;
    font-weight: 600;
    transition:
      color var(--dur-1) var(--ease-out),
      padding var(--dur-2) var(--ease-out);
  }
  .links a:hover {
    color: var(--clay-deep);
    padding-left: var(--s-2);
  }
</style>
