---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { yearOf } from "../utils/format";
import type { Entry } from "../data/types";
import EntryCard from "../components/EntryCard.astro";
import EntryFilter from "../components/EntryFilter.svelte";
import CTABand from "../components/CTABand.astro";
import PageHead from "../components/PageHead.astro";
import { Clock } from "lucide-astro";

interface FilterOption {
  value: string;
  label: string;
  accent?: string;
}

interface Props {
  lang: Lang;
  path: string;
  basePath: string;
  entries: Entry[];
  kicker: string;
  title: string;
  lede: string;
  pageTitle?: string;
  emptyMessage: string;
  kinds?: FilterOption[];
  kindLabel?: string;
  programs?: FilterOption[];
  /** For mixed lists: base path per entry kind, e.g. { donor: "/blogs/donors" }. */
  kindPaths?: Record<string, string>;
  showProgram?: boolean;
  showAuthor?: boolean;
  showYear?: boolean;
  ctaKicker?: string;
  ctaTitle?: string;
  ctaBody?: string;
}

const {
  lang,
  path,
  basePath,
  entries,
  kicker,
  title,
  lede,
  pageTitle,
  emptyMessage,
  kinds = [],
  kindLabel = "",
  programs = [],
  kindPaths,
  showProgram = false,
  showAuthor = false,
  showYear = false,
  ctaKicker,
  ctaTitle,
  ctaBody,
} = Astro.props;

const t = useTranslations(lang);

const sorted = [...entries].sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""));
const years = Array.from(new Set(entries.map((e) => yearOf(e.date)).filter(Boolean) as string[]))
  .sort()
  .reverse()
  .map((y) => ({ value: y, label: y }));

const countTemplate = t("stories.count");
const countOne = t("stories.count.one");
const hasFilter = kinds.length > 0 || programs.length > 0 || showYear;
const isEmpty = entries.length === 0;
---

<BaseLayout lang={lang} path={path} title={pageTitle ?? title} description={lede}>
  <PageHead kicker={kicker} title={title} lede={lede} />

  <section class="archive">
    <div class="container">
      {hasFilter && !isEmpty && (
        <div class="controls">
          <EntryFilter
            client:load
            kinds={kinds}
            programs={programs}
            years={showYear ? years : []}
            kindLabel={kindLabel}
            programLabel={t("stories.filter.programme")}
            yearLabel={t("stories.filter.year")}
            allLabel={t("stories.filter.all")}
            countTemplate={countTemplate}
            countOne={countOne}
          />
          <p class="count" data-count aria-live="polite">
            {(sorted.length === 1 ? countOne : countTemplate).replace("{n}", String(sorted.length))}
          </p>
        </div>
      )}

      {isEmpty ? (
        <div class="empty empty--page">
          <Clock size={22} strokeWidth={1.6} aria-hidden="true" />
          <p>{emptyMessage}</p>
        </div>
      ) : (
        <>
          <ul class="entry-list" data-entry-list>
            {sorted.map((entry) => (
              <li
                data-entry
                data-kind={(entry as any).kind ?? ""}
                data-program={entry.program ?? ""}
                data-year={yearOf(entry.date) ?? "none"}
              >
                <EntryCard
                  entry={entry}
                  lang={lang}
                  basePath={kindPaths?.[(entry as any).kind] ?? basePath}
                  showProgram={showProgram}
                  showAuthor={showAuthor}
                />
              </li>
            ))}
          </ul>
          <p class="empty" data-empty hidden>
            {emptyMessage}
          </p>
        </>
      )}
    </div>
  </section>

  <slot name="after" />

  <CTABand
    lang={lang}
    kicker={ctaKicker ?? t("home.impact.kicker")}
    title={ctaTitle ?? t("home.impact.title")}
    body={ctaBody ?? t("home.impact.body")}
  />
</BaseLayout>

<style>
  .archive {
    padding-top: 0;
  }
  .controls {
    position: sticky;
    top: var(--head-h);
    z-index: 5;
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-4) var(--s-5);
    margin-bottom: var(--s-7);
    padding-block: var(--s-4);
    background: var(--paper);
    border-block: 1px solid var(--rule);
  }
  .count {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-2);
    margin: 0;
    padding-bottom: 0.4em;
  }
  .entry-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: var(--s-8) var(--s-6);
  }
  /* On the unfiltered list, the newest entry leads at full width. */
  .entry-list:not([data-filtered]) > li:first-child {
    grid-column: 1 / -1;
    padding-bottom: var(--s-7);
    border-bottom: 1px solid var(--rule);
  }
  .empty {
    color: var(--ink-2);
    padding-block: var(--s-7);
    margin: 0;
    max-width: 52ch;
  }
  .empty--page {
    display: flex;
    align-items: center;
    gap: var(--s-4);
    max-width: none;
    padding: clamp(2rem, 6vw, 4rem);
    border: 1.5px dashed var(--rule-strong);
    border-radius: var(--r-4);
    font-size: var(--step-1);
  }
  .empty--page :global(svg) {
    color: var(--clay);
    flex: none;
  }
  .empty--page p {
    margin: 0;
  }
  @media (max-width: 40rem) {
    .controls {
      position: static;
    }
  }
</style>
