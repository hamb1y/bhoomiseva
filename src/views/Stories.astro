---
import EntryIndex from "./EntryIndex.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, localePath, lx } from "../i18n/utils";
import { stories } from "../data/stories";
import { programs } from "../data/programs";
import { ArrowUpRight } from "lucide-astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
const programOptions = programs.map((p) => ({
  value: p.id,
  label: lx(p.kicker, lang),
  accent: p.accent,
}));
---

<EntryIndex
  lang={lang}
  path="/stories"
  basePath="/stories"
  entries={stories}
  kicker={t("stories.kicker")}
  title={t("stories.title")}
  pageTitle={t("nav.stories")}
  emptyMessage={t("stories.empty")}
  programs={programOptions}
  showProgram
  showYear
>
  <section class="events" slot="after">
    <div class="container">
      <div class="events-cta">
        <div>
          <h2 class="events-title">{t("events.title")}</h2>
          <p>{t("events.lede")}</p>
        </div>
        <a class="btn btn--outline" href={localePath("/events", lang)}>
          {t("cta.allEvents")}
          <ArrowUpRight size={16} stroke-width={1.7} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>
</EntryIndex>

<style>
  .events {
    padding-top: 0;
  }
  .events-cta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-5) var(--s-7);
    padding: clamp(2rem, 5vw, 3.5rem);
    background: var(--paper-sunk);
    border-radius: var(--r-4);
  }
  .events-title {
    font-size: var(--step-3);
    margin: 0 0 var(--s-3);
  }
  .events-cta p {
    margin: 0;
    color: var(--ink-2);
    max-width: 52ch;
  }
</style>
