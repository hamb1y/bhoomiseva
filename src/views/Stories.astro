---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, lx } from "../i18n/utils";
import { stories } from "../data/stories";
import { updates } from "../data/updates";
import { programs, programById } from "../data/programs";
import { yearOf, formatDate } from "../utils/format";
import StoryCard from "../components/StoryCard.astro";
import StoryFilter from "../components/StoryFilter.svelte";
import CTABand from "../components/CTABand.astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const sorted = [...stories].sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""));

const programOptions = programs.map((p) => ({ value: p.id, label: lx(p.kicker, lang) }));
const years = Array.from(new Set(stories.map((s) => yearOf(s.date)).filter(Boolean) as string[]))
  .sort()
  .reverse()
  .map((y) => ({ value: y, label: y }));

const countTemplate = t("stories.count");
---

<BaseLayout lang={lang} path="/stories" title={t("nav.stories")} description={t("stories.lede")}>
  <section class="head">
    <div class="container">
      <p class="eyebrow">{t("stories.kicker")}</p>
      <h1>{t("stories.title")}</h1>
      <p class="lede measure">{t("stories.lede")}</p>
    </div>
  </section>

  <section class="archive">
    <div class="container">
      <div class="controls">
        <StoryFilter
          client:load
          programmeLabel={t("stories.filter.programme")}
          yearLabel={t("stories.filter.year")}
          allLabel={t("stories.filter.all")}
          programmes={programOptions}
          years={years}
          countTemplate={countTemplate}
        />
        <p class="count" data-count>
          {countTemplate.replace("{n}", String(sorted.length))}
        </p>
      </div>

      <ul class="story-list">
        {sorted.map((s) => {
          const year = yearOf(s.date) ?? "none";
          return (
            <li data-story data-program={s.program} data-year={year}>
              <StoryCard story={s} lang={lang} />
            </li>
          );
        })}
      </ul>

      <p class="empty" data-empty hidden>
        {t("stories.empty")}
      </p>
    </div>
  </section>

  <section class="events">
    <div class="container">
      <h2 class="events-title">
        {lx({ en: "Events and ongoing work", kn: "ಕಾರ್ಯಕ್ರಮಗಳು ಮತ್ತು ನಡೆಯುತ್ತಿರುವ ಕೆಲಸ" }, lang)}
      </h2>
      <ul class="timeline">
        {updates.map((u) => (
          <li class:list={[`accent-${programById(u.program)?.accent ?? "brand"}`]}>
            <span class="when">{u.date ? formatDate(u.date, lang) : lx(u.period ?? "", lang)}</span>
            <span class="what">{lx(u.title, lang)}</span>
            <span class="where">{lx(u.location, lang)}</span>
          </li>
        ))}
      </ul>
    </div>
  </section>

  <CTABand
    lang={lang}
    kicker={t("home.impact.kicker")}
    title={t("home.impact.title")}
    body={t("home.impact.body")}
  />
</BaseLayout>

<style>
  .head {
    padding-bottom: var(--s-7);
  }
  h1 {
    margin: var(--s-4) 0 0;
  }
  .lede {
    margin-top: var(--s-5);
    font-size: var(--step-1);
    color: var(--ink-2);
  }
  .archive .container {
    border-top: 1px solid var(--rule-strong);
    padding-top: var(--s-5);
  }
  .controls {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: end;
    gap: var(--s-5);
    margin-bottom: var(--s-6);
  }
  .count {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-3);
    margin: 0;
  }
  .story-list {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 24rem), 1fr));
    gap: var(--s-6) var(--s-7);
  }
  .empty {
    color: var(--ink-2);
    padding-block: var(--s-6);
  }
  .events .container {
    border-top: 1px solid var(--rule);
    padding-top: var(--s-6);
  }
  .events-title {
    font-size: var(--step-2);
    margin: 0 0 var(--s-5);
  }
  .timeline {
    list-style: none;
    padding: 0;
    margin: 0;
  }
  .timeline li {
    display: grid;
    grid-template-columns: 12rem 1fr 16rem;
    gap: var(--s-4);
    align-items: baseline;
    padding-block: var(--s-4);
    border-bottom: 1px solid var(--rule);
  }
  .when {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--accent, var(--clay));
  }
  .what {
    color: var(--ink);
  }
  .where {
    font-family: var(--font-mono);
    font-size: var(--step--1);
    color: var(--ink-3);
  }
  @media (max-width: 46rem) {
    .timeline li {
      grid-template-columns: 1fr;
      gap: var(--s-1);
    }
  }
</style>
