---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations } from "../i18n/utils";
import { site } from "../data/site";
import DonateWidget from "../components/DonateWidget.svelte";
import PageHead from "../components/PageHead.astro";
import { ShieldCheck } from "lucide-astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

// Suggested amounts are set per cause in Site settings.
const causes = (["education", "farmers", "cow", "children", "any"] as const).map((value) => ({
  value,
  label: t(`cause.${value}`),
  amounts: site.donationAmounts[value] ?? [],
}));

const labels = {
  purpose: t("donate.cause"),
  amount: t("donate.amount"),
  total: t("donate.total"),
  upi: t("donate.upi"),
  copy: t("donate.copy"),
  copied: t("donate.copied"),
  qr: t("donate.qr"),
  payUpi: t("donate.payUpi"),
  payUpiNoAmount: t("donate.payUpiNoAmount"),
  confirmTitle: t("donate.confirm.title"),
  confirmBody: t("donate.confirm.body"),
  causeNote: t("donate.causeNote"),
  unverified: t("donate.unverified"),
  from: t("donate.from"),
  message: t("donate.message"),
  optional: t("donate.optional"),
  supported: t("donate.supported"),
  whatsapp: t("cta.whatsapp"),
};
---

<BaseLayout lang={lang} path="/donate" title={t("nav.donate")} description={t("donate.lede")}>
  <PageHead kicker={t("donate.kicker")} title={t("donate.title")} lede={t("donate.lede")} />

  <section class="slip-section">
    <div class="container">
      <DonateWidget
        client:load
        causes={causes}
        labels={labels}
        upi={site.payment.upi}
        payeeName={site.name}
        verified={site.payment.verified}
        whatsapp={site.whatsapp}
        email={site.email}
      />
    </div>
  </section>

  <section class="accountability">
    <div class="container">
      <p class="note">
        <ShieldCheck size={22} stroke-width={1.7} aria-hidden="true" />
        <span>
          {t("donate.accountability")}
        </span>
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .slip-section {
    padding-top: 0;
  }
  .accountability {
    padding-top: 0;
  }
  .note {
    display: flex;
    gap: var(--s-4);
    margin: 0;
    padding-top: var(--s-6);
    border-top: 1px solid var(--rule-strong);
    color: var(--ink-2);
    max-width: 72ch;
  }
  .note :global(svg) {
    flex: none;
    color: var(--leaf);
    margin-top: 0.1em;
  }

  /* The fixed pay bar on phones sits over the last of the page otherwise. */
  @media (max-width: 40rem) {
    :global(body) {
      padding-bottom: 5.5rem;
    }
  }
</style>
