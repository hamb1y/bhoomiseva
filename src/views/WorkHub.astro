---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, localePath, lx } from "../i18n/utils";
import { programs } from "../data/programs";
import { storiesByProgram } from "../data/stories";
import { programHref } from "../lib/paths";
import { objectPosition } from "../utils/format";
import CTABand from "../components/CTABand.astro";
import PageHead from "../components/PageHead.astro";
import { ArrowUpRight } from "lucide-astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} path="/work" title={t("nav.work")} description={t("work.lede")}>
  <PageHead kicker={t("work.kicker")} title={t("work.title")} lede={t("work.lede")} />

  <div class="container">
    <ul class="register">
      {programs.map((p) => (
        <li class:list={["row", `accent-${p.accent}`]}>
          <a class="media" href={localePath(programHref(p.id), lang)} tabindex="-1">
            <img
              class="thumb"
              src={p.image}
              alt={p.imageAlt ? lx(p.imageAlt, lang) : lx(p.title, lang)}
              style={`object-position:${objectPosition(p.imageFocal)}`}
              loading="lazy"
              decoding="async"
            />
          </a>
          <div class="main">
            <p class="eyebrow">{lx(p.kicker, lang)}</p>
            <h2>
              <a href={localePath(programHref(p.id), lang)}>{lx(p.title, lang)}</a>
            </h2>
            <p class="sum">{lx(p.summary, lang)}</p>
            <p class="facts">
              {lx(
                {
                  en: `${p.activities.length} areas of work · ${storiesByProgram(p.id).length} documented stories`,
                  kn: `${p.activities.length} ಕೆಲಸದ ಕ್ಷೇತ್ರಗಳು · ${storiesByProgram(p.id).length} ದಾಖಲಿತ ಕಥೆಗಳು`,
                },
                lang,
              )}
            </p>
            <a class="btn btn--ink" href={localePath(programHref(p.id), lang)}>
              {t("cta.learnMore")}
              <ArrowUpRight size={17} stroke-width={1.8} aria-hidden="true" />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <CTABand
    lang={lang}
    kicker={t("home.impact.kicker")}
    title={t("home.impact.title")}
    body={t("home.impact.body")}
  />
</BaseLayout>

<style>
  .register {
    list-style: none;
    margin: 0 0 var(--section);
    padding: 0;
    display: grid;
    gap: clamp(4rem, 9vw, 8rem);
  }
  .row {
    display: grid;
    grid-template-columns: minmax(0, 1.25fr) minmax(0, 1fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .row:nth-child(even) .media {
    order: 2;
  }
  .media {
    display: block;
  }
  .thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-4);
    filter: var(--photo-filter);
  }
  .main h2 {
    margin: var(--s-4) 0 var(--s-4);
    font-size: var(--step-4);
    max-width: 14ch;
  }
  .main h2 a {
    text-decoration: none;
  }
  .main h2 a:hover {
    color: var(--accent);
  }
  .sum {
    margin: 0 0 var(--s-5);
    font-size: var(--step-1);
    line-height: 1.5;
    color: var(--ink-2);
    max-width: 44ch;
  }
  .facts {
    display: inline-block;
    margin: 0 0 var(--s-6);
    font-family: var(--font-mono);
    font-stretch: 82%;
    font-variant-numeric: tabular-nums;
    font-size: var(--step--1);
    color: var(--ink-2);
  }
  .main .btn {
    display: flex;
    width: fit-content;
  }
  @media (max-width: 62rem) {
    .row {
      grid-template-columns: 1fr;
    }
    .row:nth-child(even) .media {
      order: 0;
    }
  }
</style>
