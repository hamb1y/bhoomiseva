---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, localePath, lx } from "../i18n/utils";
import { programs } from "../data/programs";
import { storiesByProgram } from "../data/stories";
import { programHref } from "../lib/paths";
import { objectPosition } from "../utils/format";
import CTABand from "../components/CTABand.astro";
import { ArrowUpRight } from "lucide-astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);
---

<BaseLayout lang={lang} path="/work" title={t("nav.work")} description={t("work.lede")}>
  <section class="head">
    <div class="container">
      <p class="eyebrow">{t("work.kicker")}</p>
      <h1>{t("work.title")}</h1>
      <p class="lede measure">{t("work.lede")}</p>
    </div>
  </section>

  <div class="container">
    <ul class="register">
      {programs.map((p) => (
        <li class:list={["row", `accent-${p.accent}`]}>
          <img
            class="thumb"
            src={p.image}
            alt={p.imageAlt ? lx(p.imageAlt, lang) : lx(p.title, lang)}
            style={`object-position:${objectPosition(p.imageFocal)}`}
            loading="lazy"
            decoding="async"
          />
          <div class="main">
            <p class="eyebrow">{lx(p.kicker, lang)}</p>
            <h2>
              <a href={localePath(programHref(p.id), lang)}>{lx(p.title, lang)}</a>
            </h2>
            <p>{lx(p.summary, lang)}</p>
            <p class="facts">
              {lx(
                {
                  en: `${p.activities.length} areas of work · ${storiesByProgram(p.id).length} documented stories`,
                  kn: `${p.activities.length} ಕೆಲಸದ ಕ್ಷೇತ್ರಗಳು · ${storiesByProgram(p.id).length} ದಾಖಲಿತ ಕಥೆಗಳು`,
                },
                lang,
              )}
            </p>
            <a class="more" href={localePath(programHref(p.id), lang)}>
              {t("cta.learnMore")}
              <ArrowUpRight size={15} stroke-width={1.7} aria-hidden="true" />
            </a>
          </div>
        </li>
      ))}
    </ul>
  </div>

  <CTABand
    lang={lang}
    kicker={t("home.impact.kicker")}
    title={t("home.impact.title")}
    body={t("home.impact.body")}
  />
</BaseLayout>

<style>
  .head {
    padding-bottom: var(--s-7);
  }
  h1 {
    margin: var(--s-4) 0 0;
    max-width: 16ch;
  }
  .lede {
    margin-top: var(--s-5);
    font-size: var(--step-1);
    color: var(--ink-2);
  }
  .register {
    list-style: none;
    margin: 0;
    padding: 0;
  }
  .row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .main h2 {
    margin: var(--s-3) 0 var(--s-3);
    font-size: var(--step-3);
    max-width: 22ch;
  }
  .main h2 a {
    text-decoration: none;
  }
  .main h2 a:hover {
    color: var(--accent);
  }
  .main p {
    margin: 0 0 var(--s-4);
    color: var(--ink-2);
    max-width: 56ch;
  }
  .facts {
    font-size: var(--step--1);
    color: var(--ink-3);
    margin-bottom: var(--s-4);
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    font-weight: 550;
  }
  .more:hover {
    color: var(--accent);
  }
  .thumb {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-3);
  }
  @media (max-width: 62rem) {
    .row {
      grid-template-columns: 1fr;
    }
  }
</style>
