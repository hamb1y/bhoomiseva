---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, localePath, lx } from "../i18n/utils";
import { pick, site } from "../data/site";
import { programs } from "../data/programs";
import { stories, featuredStory } from "../data/stories";
import { programHref } from "../lib/paths";
import { objectPosition } from "../utils/format";
import CTABand from "../components/CTABand.astro";
import { ArrowUpRight, ArrowRight } from "lucide-astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const programLabel = (id: string) => {
  const p = programs.find((x) => x.id === id);
  return p ? lx(p.kicker, lang) : "";
};
const yearOf = (s: (typeof stories)[number]) =>
  s.date ? s.date.slice(0, 4) : s.period ? lx(s.period, lang) : "";

// The hero repeats the featured story's photograph, so the strip below it
// starts with the next story to avoid showing the same frame twice.
const strip = [...stories]
  .sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""))
  .filter((s) => s.slug !== featuredStory.slug);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: site.name,
  email: site.email,
  telephone: site.phone,
  url: "https://bhoomiseva.org",
  description: pick(site.shortDescription, "en"),
  areaServed: "Karnataka, India",
};
---

<BaseLayout lang={lang} path="/" jsonLd={jsonLd}>
  <section class="hero">
    {
      featuredStory.image && (
        <img
          class="hero-img"
          src={featuredStory.image}
          alt={featuredStory.imageAlt ? lx(featuredStory.imageAlt, lang) : lx(featuredStory.title, lang)}
        />
      )
    }
    <div class="hero-block">
      <p class="hero-kicker">{t("home.hero.kicker")}</p>
      <h1>{t("site.tagline")}</h1>
      <div class="hero-cta">
        <a class="btn btn--primary" href={localePath("/donate", lang)}>
          {t("cta.donate")}
          <ArrowRight size={17} stroke-width={1.7} aria-hidden="true" />
        </a>
        <a class="hero-link" href={localePath("/stories", lang)}>{t("cta.readStories")}</a>
      </div>
    </div>
  </section>

  <section class="pillars">
    {
      programs.map((p) => (
        <article class:list={["pillar", `pillar-${p.accent}`]}>
          <div class="container pillar-inner">
            <div class="pillar-media">
              {p.image && (
                <img
                  src={p.image}
                  alt={p.imageAlt ? lx(p.imageAlt, lang) : lx(p.title, lang)}
                  style={`object-position:${objectPosition(p.imageFocal)}`}
                  loading="lazy"
                  decoding="async"
                />
              )}
            </div>
            <div class="pillar-copy">
              <p class="pillar-kicker">{lx(p.kicker, lang)}</p>
              <h2>
                <a href={localePath(programHref(p.id), lang)}>{lx(p.title, lang)}</a>
              </h2>
              <p class="pillar-sum">{lx(p.summary, lang)}</p>
              <ul class="activities">
                {p.activities.map((a) => (
                  <li>{lx(a.title, lang)}</li>
                ))}
              </ul>
              <a class="pillar-more" href={localePath(programHref(p.id), lang)}>
                {t("cta.learnMore")}
                <ArrowUpRight size={15} stroke-width={1.7} aria-hidden="true" />
              </a>
            </div>
          </div>
        </article>
      ))
    }
  </section>

  <section class="strip-section">
    <div class="container">
      <div class="strip-head">
        <h2 class="section-title">{t("home.updates.title")}</h2>
        <a class="more" href={localePath("/stories", lang)}>
          {t("cta.allStories")}
          <ArrowRight size={16} stroke-width={1.7} aria-hidden="true" />
        </a>
      </div>
    </div>
    <ul class="strip">
      {
        strip.map((s) => (
          <li>
            <a href={localePath(`/stories/${s.slug}`, lang)}>
              {s.image && (
                <img
                  src={s.image}
                  alt={s.imageAlt ? lx(s.imageAlt, lang) : lx(s.title, lang)}
                  style={`object-position:${objectPosition(s.imageFocal)}`}
                  loading="lazy"
                  decoding="async"
                />
              )}
              <span class="p-name">{lx(s.title, lang)}</span>
              <span class="p-meta">
                {programLabel(s.program)}
                {yearOf(s) ? ` · ${yearOf(s)}` : ""}
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <CTABand
    lang={lang}
    kicker={t("home.impact.kicker")}
    title={t("home.impact.title")}
    body={t("home.impact.body")}
  />
</BaseLayout>

<style>
  /* 1. The photograph leads; the headline sits on a solid block that overlaps
     its bottom edge rather than on a scrim over the picture. */
  .hero {
    position: relative;
  }
  .hero-img {
    width: 100%;
    height: clamp(24rem, 78vh, 46rem);
    object-fit: cover;
    display: block;
    filter: saturate(0.94) sepia(0.06) contrast(1.02);
  }
  .hero-block {
    width: min(38rem, 88%);
    margin: -4rem auto 0;
    position: relative;
    z-index: 1;
    background: var(--clay);
    color: var(--paper-raised);
    border-radius: var(--r-3);
    padding: clamp(1.5rem, 4vw, 2.75rem);
  }
  .hero-kicker {
    margin: 0;
    font-weight: 600;
    color: color-mix(in oklab, var(--paper-raised) 82%, var(--clay));
  }
  .hero-block h1 {
    margin: 0.25em 0 0;
    font-size: clamp(2.1rem, 1.1rem + 5vw, 5.5rem);
    line-height: 0.98;
    letter-spacing: -0.03em;
    max-width: 14ch;
  }
  .hero-cta {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: var(--s-4);
    margin-top: var(--s-6);
  }
  .hero-link {
    color: var(--paper-raised);
    font-weight: 600;
    text-underline-offset: 0.25em;
  }

  /* 2. Each programme takes a full-width ground of its own colour, so the page
     is blocks of colour rather than one long cream scroll. */
  .pillar {
    padding-block: clamp(3rem, 6vw, 5.5rem);
  }
  .pillar-education {
    background: var(--turmeric);
    color: var(--ink);
  }
  .pillar-farmers {
    background: var(--leaf);
    color: var(--paper-raised);
  }
  .pillar-children {
    background: var(--indigo);
    color: var(--paper-raised);
  }
  .pillar-inner {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .pillar-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-3);
    display: block;
    filter: saturate(0.94) sepia(0.06) contrast(1.02);
  }
  .pillar-copy a,
  .pillar-copy .pillar-more {
    color: inherit;
  }
  .pillar-kicker {
    margin: 0;
    font-weight: 600;
    opacity: 0.85;
  }
  .pillar-copy h2 {
    margin: var(--s-2) 0 var(--s-3);
    font-size: var(--step-4);
    max-width: 18ch;
  }
  .pillar-copy h2 a {
    text-decoration: none;
  }
  .pillar-sum {
    margin: 0 0 var(--s-4);
    max-width: 52ch;
    opacity: 0.92;
  }
  .activities {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }
  .activities li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--step--1);
    max-width: 40ch;
    opacity: 0.92;
  }
  .activities li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: currentColor;
  }
  .pillar-more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-weight: 600;
    text-decoration: none;
  }
  .pillar-more:hover {
    text-decoration: underline;
    text-underline-offset: 0.25em;
  }

  /* 4. People, not cards: tall portraits in a sideways strip. */
  .strip-section {
    padding-block: clamp(2.5rem, 5vw, 4rem);
  }
  .strip-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-bottom: var(--s-5);
  }
  .section-title {
    font-size: var(--step-3);
    margin: 0;
  }
  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    font-weight: 600;
    color: var(--ink);
  }
  .more:hover {
    color: var(--clay);
  }
  .strip {
    list-style: none;
    margin: 0;
    padding: 0 var(--gutter) var(--s-2);
    display: grid;
    grid-auto-flow: column;
    grid-auto-columns: minmax(13rem, 17rem);
    gap: var(--s-5);
    overflow-x: auto;
    scroll-snap-type: x mandatory;
    scroll-padding-inline: var(--gutter);
  }
  .strip li {
    scroll-snap-align: start;
  }
  .strip a {
    display: grid;
    gap: var(--s-2);
    text-decoration: none;
    color: var(--ink);
  }
  .strip img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--r-3);
    display: block;
    filter: saturate(0.94) sepia(0.06) contrast(1.02);
  }
  .p-name {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 24,
      "WONK" 1;
    font-weight: 600;
    font-size: var(--step-1);
    line-height: 1.15;
  }
  .strip a:hover .p-name {
    color: var(--clay);
  }
  .p-meta {
    font-size: var(--step--1);
    color: var(--ink-2);
  }

  @media (max-width: 62rem) {
    .pillar-inner {
      grid-template-columns: 1fr;
    }
  }
</style>
