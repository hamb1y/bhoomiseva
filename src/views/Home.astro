---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, localePath, lx } from "../i18n/utils";
import { pick, site } from "../data/site";
import { programs } from "../data/programs";
import { stories, featuredStory } from "../data/stories";
import { programHref } from "../lib/paths";
import StoryCard from "../components/StoryCard.astro";
import PhotoFrame from "../components/PhotoFrame.astro";
import CTABand from "../components/CTABand.astro";
import { ArrowUpRight, ArrowRight } from "lucide-astro";

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useTranslations(lang);

const sorted = [...stories].sort((a, b) => (b.date ?? "").localeCompare(a.date ?? ""));
const recent = sorted.filter((s) => s.slug !== featuredStory.slug).slice(0, 3);

const jsonLd = {
  "@context": "https://schema.org",
  "@type": "NGO",
  name: site.name,
  email: site.email,
  telephone: site.phone,
  url: "https://bhoomiseva.org",
  description: pick(site.shortDescription, "en"),
  areaServed: "Karnataka, India",
};
---

<BaseLayout lang={lang} path="/" jsonLd={jsonLd}>
  <section class="hero">
    <div class="container grid">
      <div class="lede">
        <p class="eyebrow">{t("home.hero.kicker")}</p>
        <h1>{t("site.tagline")}</h1>
        <p class="hero-body">{pick(site.shortDescription, lang)}</p>
        <div class="hero-cta">
          <a class="btn btn--primary" href={localePath("/donate", lang)}>
            {t("cta.donate")}
            <ArrowRight size={17} stroke-width={1.7} aria-hidden="true" />
          </a>
          <a class="btn btn--outline" href={localePath("/stories", lang)}>
            {t("cta.readStories")}
          </a>
        </div>
      </div>

      <aside class="feature">
        <PhotoFrame
          src={featuredStory.image}
          alt={
            featuredStory.imageAlt
              ? lx(featuredStory.imageAlt, lang)
              : lx(featuredStory.title, lang)
          }
          caption={
            featuredStory.imageAlt
              ? lx(featuredStory.imageAlt, lang)
              : lx(featuredStory.location, lang)
          }
          ratio="4 / 3"
          accent="farmers"
        />
        <div class="feature-body">
          <h2>
            <a href={localePath(`/stories/${featuredStory.slug}`, lang)}>
              {lx(featuredStory.title, lang)}
            </a>
          </h2>
          <p class="feature-sum">{lx(featuredStory.summary, lang)}</p>
          <a class="more" href={localePath(`/stories/${featuredStory.slug}`, lang)}>
            {t("common.readEntry")}
            <ArrowUpRight size={15} stroke-width={1.7} aria-hidden="true" />
          </a>
        </div>
      </aside>
    </div>
  </section>

  <section class="pillars">
    <div class="container">
      <h2 class="section-title">{t("home.pillars.title")}</h2>
    </div>
    <div class="container program-list">
      {programs.map((p, i) => (
        <article class:list={["program", `accent-${p.accent}`, { flip: i % 2 === 1 }]}>
          <div class="program-media">
            <img
              src={p.image}
              alt={p.imageAlt ? lx(p.imageAlt, lang) : lx(p.title, lang)}
              loading="lazy"
              decoding="async"
            />
          </div>
          <div class="program-main">
            <p class="eyebrow">{lx(p.kicker, lang)}</p>
            <h3>
              <a href={localePath(programHref(p.id), lang)}>{lx(p.title, lang)}</a>
            </h3>
            <p>{lx(p.summary, lang)}</p>
            <ul class="activities">
              {p.activities.map((a) => (
                <li>{lx(a.title, lang)}</li>
              ))}
            </ul>
            <a class="more" href={localePath(programHref(p.id), lang)}>
              {t("cta.learnMore")}
              <ArrowUpRight size={15} stroke-width={1.7} aria-hidden="true" />
            </a>
          </div>
        </article>
      ))}
    </div>
  </section>

  <section class="band">
    <a class="band-link" href={localePath("/stories/farmer-training-kabbalu-2023", lang)}>
      <img src="/images/farmer-training-2.webp" alt="" loading="lazy" decoding="async" />
      <div class="band-caption">
        <span class="band-title">
          {lx(
            {
              en: "Farmer training at Chirantana School, Kabbalu, July 2023",
              kn: "ಚಿರಂತನ ಶಾಲೆ, ಕಬ್ಬಾಳಿನಲ್ಲಿ ರೈತ ತರಬೇತಿ, ಜುಲೈ 2023",
            },
            lang,
          )}
        </span>
        <ArrowUpRight size={16} stroke-width={1.7} aria-hidden="true" />
      </div>
    </a>
  </section>

  <section class="model">
    <div class="container model-grid">
      <div class="model-media">
        <img
          src="/images/cow-donation.webp"
          alt={lx(
            { en: "Cow donation at Kabbalu, Kanakapura", kn: "ಕಬ್ಬಾಳು, ಕನಕಪುರದಲ್ಲಿ ಹಸು ದಾನ" },
            lang,
          )}
          loading="lazy"
          decoding="async"
        />
      </div>
      <div class="model-copy">
        <p class="eyebrow">{t("home.model.kicker")}</p>
        <h2>{t("home.model.title")}</h2>
        <p class="model-body">{t("home.model.body")}</p>
        <a class="btn btn--text" href={localePath(`/stories/${featuredStory.slug}`, lang)}>
          {t("common.readEntry")}
          <ArrowRight size={16} stroke-width={1.7} aria-hidden="true" />
        </a>
      </div>
    </div>
  </section>

  <section class="recent">
    <div class="container">
      <div class="recent-head">
        <h2 class="section-title">{t("home.updates.title")}</h2>
        <a class="btn btn--text all" href={localePath("/stories", lang)}>
          {t("cta.allStories")}
          <ArrowRight size={16} stroke-width={1.7} aria-hidden="true" />
        </a>
      </div>
      <div class="recent-grid">
        {recent.map((s) => (
          <StoryCard story={s} lang={lang} />
        ))}
      </div>
    </div>
  </section>

  <CTABand
    lang={lang}
    kicker={t("home.impact.kicker")}
    title={t("home.impact.title")}
    body={t("home.impact.body")}
  />
</BaseLayout>

<style>
  .hero {
    padding-block: clamp(2.5rem, 6vw, 5rem) clamp(3rem, 7vw, 6rem);
  }
  .hero .grid {
    display: grid;
    grid-template-columns: 1.15fr 0.85fr;
    gap: clamp(2rem, 5vw, 4.5rem);
    align-items: start;
  }
  h1 {
    margin: var(--s-4) 0 0;
    max-width: 16ch;
    font-size: clamp(2.1rem, 1.6rem + 2.4vw, 3.3rem);
  }
  .hero-body {
    margin: var(--s-5) 0 0;
    font-size: var(--step-0);
    color: var(--ink-2);
    max-width: 54ch;
  }
  .hero-cta {
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-3);
    margin-top: var(--s-6);
  }
  .feature {
    display: grid;
    gap: var(--s-4);
  }
  .feature-body {
    display: grid;
    gap: var(--s-2);
  }
  .feature h2 {
    font-size: var(--step-2);
    margin: 0;
  }
  .feature h2 a {
    text-decoration: none;
  }
  .feature h2 a:hover {
    color: var(--clay);
  }
  .feature-sum {
    margin: 0;
    color: var(--ink-2);
  }

  .section-title {
    font-size: var(--step-3);
    margin: 0 0 var(--s-6);
  }

  .program-list {
    display: grid;
  }
  .program {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
    padding-block: clamp(2.5rem, 6vw, 4.5rem);
  }
  .program.flip .program-media {
    order: 2;
  }
  .program-media img {
    width: 100%;
    aspect-ratio: 4 / 3;
    object-fit: cover;
    border-radius: var(--r-3);
  }
  .program-main h3 {
    margin: var(--s-3) 0 var(--s-3);
    font-size: var(--step-3);
  }
  .program-main h3 a {
    text-decoration: none;
  }
  .program-main h3 a:hover {
    color: var(--accent);
  }
  .program-main > p {
    margin: 0 0 var(--s-4);
    color: var(--ink-2);
    max-width: 54ch;
  }
  .activities {
    list-style: none;
    padding: 0;
    margin: 0 0 var(--s-5);
    display: flex;
    flex-wrap: wrap;
    gap: var(--s-2) var(--s-5);
  }
  .activities li {
    position: relative;
    padding-left: 1rem;
    font-size: var(--step--1);
    color: var(--ink-2);
    max-width: 40ch;
  }
  .activities li::before {
    content: "";
    position: absolute;
    left: 0;
    top: 0.55em;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
  }

  .band {
    padding-block: clamp(2rem, 5vw, 4rem);
  }
  .band-link {
    display: block;
    position: relative;
    text-decoration: none;
    color: var(--paper-raised);
  }
  .band-link img {
    width: 100%;
    aspect-ratio: 21 / 9;
    object-fit: cover;
    display: block;
  }
  .band-caption {
    position: absolute;
    inset: auto 0 0 0;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: var(--s-4);
    padding: var(--s-5) clamp(1.25rem, 5vw, 4rem);
    background: linear-gradient(to top, rgba(20, 12, 8, 0.78), rgba(20, 12, 8, 0));
  }
  .band-title {
    font-family: var(--font-display);
    font-variation-settings:
      "opsz" 30,
      "WONK" 1;
    font-size: var(--step-1);
    max-width: 40ch;
  }
  .band-link:hover .band-title {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .model-grid {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }
  .model-media img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--r-3);
  }
  .model-copy h2 {
    margin: var(--s-3) 0 var(--s-4);
    max-width: 22ch;
  }
  .model-body {
    color: var(--ink-2);
    max-width: 56ch;
    margin: 0 0 var(--s-5);
  }

  .recent-head {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: var(--s-5);
    flex-wrap: wrap;
    margin-bottom: var(--s-6);
  }
  .recent-head .section-title {
    margin: 0;
  }
  .recent-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 20rem), 1fr));
    gap: var(--s-6) var(--s-7);
  }

  .more {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    text-decoration: none;
    font-weight: 550;
    color: var(--ink);
  }
  .more:hover {
    color: var(--clay);
  }

  @media (max-width: 62rem) {
    .hero .grid,
    .program,
    .model-grid {
      grid-template-columns: 1fr;
    }
    .program.flip .program-media {
      order: 0;
    }
    .band-link img {
      aspect-ratio: 16 / 9;
    }
  }
</style>
