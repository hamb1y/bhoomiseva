---
import BaseLayout from "../layouts/BaseLayout.astro";
import type { Lang } from "../i18n/ui";
import { useTranslations, localePath, lx } from "../i18n/utils";
import { programs, programById } from "../data/programs";
import type { ProgramId } from "../data/types";
import { storiesByProgram } from "../data/stories";
import { programHref } from "../lib/paths";
import EntryCard from "../components/EntryCard.astro";
import PhotoFrame from "../components/PhotoFrame.astro";
import CTABand from "../components/CTABand.astro";
import { ArrowUpRight } from "lucide-astro";

interface Props {
  lang: Lang;
  id: ProgramId;
}
const { lang, id } = Astro.props;
const t = useTranslations(lang);
const program = programById(id)!;
const related = storiesByProgram(id);
const others = programs.filter((p) => p.id !== id);

const photoCaption = {
  education: {
    en: "Tutoring session with students",
    kn: "ವಿದ್ಯಾರ್ಥಿಗಳೊಂದಿಗೆ ಪಾಠದ ಅವಧಿ",
  },
  farmers: {
    en: "Farmer training at Chirantana School, Kabbalu",
    kn: "ಚಿರಂತನ ಶಾಲೆ, ಕಬ್ಬಾಳಿನಲ್ಲಿ ರೈತ ತರಬೇತಿ",
  },
  children: {
    en: "Support delivered to a children's home",
    kn: "ಮಕ್ಕಳ ಮನೆಗೆ ನೀಡಿದ ಬೆಂಬಲ",
  },
}[id];
---

<BaseLayout
  lang={lang}
  path={programHref(id)}
  title={lx(program.kicker, lang)}
  description={lx(program.summary, lang)}
>
  <section class:list={["head", `head-${program.accent}`, `accent-${program.accent}`]}>
    <div class="container head-grid">
      <div class="head-copy">
        <p class="head-kicker">{lx(program.kicker, lang)}</p>
        <h1>{lx(program.title, lang)}</h1>
        <p class="lede">{lx(program.lede, lang)}</p>
      </div>
      <PhotoFrame
        src={program.image}
        alt={program.imageAlt ? lx(program.imageAlt, lang) : lx(program.title, lang)}
        caption={program.imageAlt ? lx(program.imageAlt, lang) : lx(photoCaption, lang)}
        focal={program.imageFocal}
        lightbox
        lightboxGroup={program.id}
        ratio="1 / 1"
        accent={program.accent}
        class="head-photo"
      />
    </div>
  </section>

  <section class:list={["activities", `accent-${program.accent}`]}>
    <div class="container">
      <h2 class="activities-title">
        {lx({ en: "What this includes", kn: "ಇದರಲ್ಲಿ ಸೇರಿರುವುದು" }, lang)}
      </h2>
      <ul class="list">
        {program.activities.map((a) => (
          <li>
            <h3>{lx(a.title, lang)}</h3>
            <p>{lx(a.body, lang)}</p>
          </li>
        ))}
      </ul>
    </div>
  </section>

  {program.gallery?.length ? (
    <section class="gallery">
      <div class="container">
        <div class="gallery-grid">
          {program.gallery.map((src) => (
            <button
              type="button"
              class="gallery-item"
              data-lightbox={src}
              data-lightbox-group={program.id}
              data-caption={lx(program.title, lang)}
              aria-label={`${lx(program.title, lang)} — open larger`}
            >
              <img src={src} alt={lx(program.title, lang)} loading="lazy" decoding="async" />
            </button>
          ))}
        </div>
      </div>
    </section>
  ) : null}

  <section class="entries">
    <div class="container">
      <h2 class="entries-title">{t("work.stories")}</h2>
      {related.length ? (
        <div class="entries-grid">
          {related.map((s) => (
            <EntryCard entry={s} lang={lang} basePath="/stories" showProgram={false} />
          ))}
        </div>
      ) : (
        <p class="empty">{t("work.noStories")}</p>
      )}
    </div>
  </section>

  <section class="others">
    <div class="container">
      <p class="eyebrow">{t("work.otherProgrammes")}</p>
      <div class="other-grid">
        {others.map((p) => (
          <a class:list={["other", `other-${p.accent}`]} href={localePath(programHref(p.id), lang)}>
            {p.image && <img src={p.image} alt="" loading="lazy" decoding="async" />}
            <span class="other-text">
              <span class="kicker">{lx(p.kicker, lang)}</span>
              <span class="title">{lx(p.title, lang)}</span>
            </span>
            <ArrowUpRight size={28} stroke-width={1.6} aria-hidden="true" />
          </a>
        ))}
      </div>
    </div>
  </section>

  <CTABand
    lang={lang}
    kicker={t("home.impact.kicker")}
    title={t("home.impact.title")}
    body={t("home.impact.body")}
  />
</BaseLayout>

<style>
  /* The programme's own colour, edge to edge. */
  .head {
    padding-block: clamp(3rem, 7vw, 6rem);
    background: var(--accent-fill);
    color: var(--paper-raised);
  }
  .head-education {
    color: var(--ink);
  }
  .head-grid {
    display: grid;
    grid-template-columns: minmax(0, 1.4fr) minmax(0, 0.8fr);
    gap: clamp(2rem, 6vw, 5rem);
    align-items: center;
  }
  .head-kicker {
    margin: 0;
    font-size: var(--step--1);
    font-weight: 600;
    opacity: 0.85;
  }
  h1 {
    margin: var(--s-4) 0 0;
    font-size: var(--step-5);
    max-width: 13ch;
  }
  .lede {
    margin-top: var(--s-6);
    font-size: var(--step-1);
    line-height: 1.6;
    max-width: 52ch;
    opacity: 0.95;
  }
  .head :global(.caption) {
    color: inherit;
    opacity: 0.85;
  }
  .head :global(.head-photo img) {
    box-shadow: var(--shadow-deep);
  }
  .head :global(:focus-visible) {
    outline-color: currentColor;
  }

  .activities-title {
    font-size: var(--step-4);
    margin: 0 0 var(--s-7);
    max-width: 16ch;
  }
  .list {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--s-7) var(--s-7);
  }
  .list li {
    padding-top: var(--s-5);
    border-top: 3px solid var(--accent-fill);
  }
  .list h3 {
    font-size: var(--step-2);
    margin: 0 0 var(--s-3);
  }
  .list p {
    margin: 0;
    color: var(--ink-2);
  }

  .gallery {
    padding-top: 0;
  }
  /* Masonry by columns: every photograph keeps its own shape. */
  .gallery-grid {
    columns: 3 16rem;
    column-gap: var(--s-4);
  }
  .gallery-item {
    display: block;
    width: 100%;
    padding: 0;
    margin: 0 0 var(--s-4);
    border: 0;
    background: none;
    cursor: zoom-in;
    break-inside: avoid;
    border-radius: var(--r-4);
    overflow: hidden;
  }
  .gallery-item img {
    width: 100%;
    height: auto;
    background: var(--paper-sunk);
    filter: var(--photo-filter);
    transition: filter var(--dur-3) var(--ease-out);
  }
  .gallery-item:hover img {
    filter: saturate(1.05) contrast(1.04);
  }

  .entries {
    background: var(--paper-sunk);
  }
  .entries-title {
    font-size: var(--step-4);
    margin-bottom: var(--s-7);
  }
  .entries-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 21rem), 1fr));
    gap: var(--s-8) var(--s-6);
  }
  .entries :global(.prog) {
    background: var(--paper);
  }
  .empty {
    color: var(--ink-2);
  }

  .other-grid {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 22rem), 1fr));
    gap: var(--s-4);
    margin-top: var(--s-5);
  }
  .other {
    position: relative;
    display: grid;
    grid-template-columns: 1fr auto;
    align-items: end;
    gap: var(--s-4);
    min-height: 16rem;
    padding: var(--s-6);
    text-decoration: none;
    border-radius: var(--r-4);
    overflow: hidden;
    isolation: isolate;
    color: #fff8f1;
    background: var(--c);
  }
  .other-education {
    --c: var(--turmeric);
    color: var(--ink);
  }
  .other-farmers {
    --c: var(--leaf);
  }
  .other-children {
    --c: var(--indigo);
  }
  /* The photograph sits behind, tinted by the programme colour. */
  .other img {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
    z-index: -2;
    filter: grayscale(0.4);
  }
  .other::before {
    content: "";
    position: absolute;
    inset: 0;
    background: var(--c);
    opacity: 0.86;
    z-index: -1;
    transition: opacity var(--dur-3) var(--ease-out);
  }
  .other:hover::before {
    opacity: 0.72;
  }
  .other-text {
    display: grid;
    gap: var(--s-2);
  }
  .other .kicker {
    font-size: var(--step--1);
    font-weight: 600;
    opacity: 0.9;
  }
  .other .title {
    font-family: var(--font-display);
    font-weight: 540;
    font-size: var(--step-3);
    letter-spacing: -0.02em;
    line-height: 1.05;
  }
  .other :global(svg) {
    transition: transform var(--dur-2) var(--ease-out);
  }
  .other:hover :global(svg) {
    transform: translate(4px, -4px);
  }
  .other:focus-visible {
    outline-color: var(--c);
  }
  @media (max-width: 62rem) {
    .head-grid {
      grid-template-columns: 1fr;
    }
    .head :global(.head-photo) {
      max-width: 26rem;
    }
  }
</style>
