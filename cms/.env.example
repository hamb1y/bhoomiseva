# Payload needs a long random secret.
PAYLOAD_SECRET=change-me-to-a-long-random-string

# SQLite by default — swap the adapter in payload.config.ts for Postgres/MySQL in production.
DATABASE_URI=file:./bhoomiseva.db

# Public origin of this CMS (used for CORS/CSRF and generated media URLs).
PAYLOAD_PUBLIC_SERVER_URL=http://localhost:3000

# Origin of the Astro site, allowed to read content, and used for admin
# "Preview" links. NEXT_PUBLIC_ is inlined into the admin bundle.
SITE_URL=http://localhost:4321
NEXT_PUBLIC_SITE_URL=http://localhost:4321
