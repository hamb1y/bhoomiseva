# ---------------------------------------------------------------------------
# Astro site
# ---------------------------------------------------------------------------

# Where the Payload CMS is running. When set, `bun run content:pull` will
# regenerate src/data/generated/* from it. The site builds fine without it,
# falling back to src/data/seed/*.
PAYLOAD_URL=http://localhost:3000

# Optional. Only needed if you lock down the CMS read access.
PAYLOAD_API_KEY=

# Public origin of this site (used for canonical URLs).
SITE_URL=http://localhost:4321

# ---------------------------------------------------------------------------
# CMS secrets live in cms/.env — see cms/.env.example
# ---------------------------------------------------------------------------
